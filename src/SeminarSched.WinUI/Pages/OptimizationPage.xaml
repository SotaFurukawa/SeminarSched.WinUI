<?xml version="1.0" encoding="utf-8" ?>
<local:WorkflowPageBase
    x:Class="SeminarSched_WinUI.Pages.OptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SeminarSched_WinUI.Pages"
    xmlns:vm="using:SeminarSched_WinUI"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <InfoBar Grid.Row="0" x:Name="ProjectRequired" Margin="24,16,24,0" />
        <ScrollViewer Grid.Row="1" x:Name="ContentPanel">
        <StackPanel MaxWidth="1200" Padding="24,16,24,32" HorizontalAlignment="Left" Spacing="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="時間割自動作成" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap">これまでの情報を基に、講師と生徒をマッチングし、自動的に時間割を作成します。できるだけ良いマッチングになるように、CP-SATと呼ばれる計算方式で、PC内部で計算を行うため、少し動作が重くなることがあります。他の作業とできるだけ併用しないで下さい。<LineBreak/>あらかじめマッチングを指定したい場合は、「アンケート取込」で優先度を変更するか、「時間割編集」であらかじめ授業を固定してください。</TextBlock>

            <Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="最適化品質" />
                    <StackPanel Width="760" HorizontalAlignment="Left" Spacing="0">
                        <Grid ColumnSpacing="12">
                            <TextBlock Text="高速" />
                            <TextBlock HorizontalAlignment="Right" Text="最高品質" />
                        </Grid>
                        <Slider
                            x:Name="QualitySlider"
                            Width="760"
                            HorizontalAlignment="Left"
                            Minimum="1"
                            Maximum="5"
                            StepFrequency="1"
                            TickFrequency="1"
                            TickPlacement="BottomRight"
                            SnapsTo="StepValues"
                            Value="3"
                            ValueChanged="QualitySlider_ValueChanged" />
                        <!-- Sliderのtickは、thumb本体の半径ぶんだけ左右へ内側寄せされた位置に描画される
                             （WinUI既定テーマのSliderHorizontalThumbWidthが実際のinset量）。固定pxを
                             決め打ちすると理論値とズレるため、コードビハインド側でテーマリソースの値から
                             実際のinsetを計算してこのGridのMarginへ反映する（Page_LoadedのAlignQualityTickLabels）。
                             不具合修正: 値1〜5（5点）は4等分の区切り位置に並ぶのであって5等分した各列の
                             中央には並ばない。5等分の列を使い2,3,4を各列の中央に置いていた以前の実装は
                             実際のtick位置とズレていた。4等分の列にした上で、2,3,4は隣り合う2列にまたがる
                             ColumnSpan="2"のCenter揃えにすることで、列の境界線（＝25%/50%/75%位置）へ
                             常に正しく揃える。 -->
                        <Grid x:Name="QualityTickLabels" Margin="9,4,9,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="1" />
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Text="2" />
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" Text="3" />
                            <TextBlock Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Text="4" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="5" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.LevelText, Mode=OneWay}" />
                    <TextBlock FontSize="16" Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.EstimatedDuration, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StrategySummary, Mode=OneWay}" />
                    <TextBlock MaxWidth="640" HorizontalAlignment="Left" Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" />
                    <InfoBar
                        x:Name="SaveErrorInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Message="品質設定を保存できませんでした。"
                        Severity="Error"
                        Title="設定の保存エラー" />
                </StackPanel>
            </Border>
            <Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="自動作成"/>
                    <InfoBar x:Name="RunStatus" IsClosable="True"/>
                    <StackPanel Spacing="2">
                        <CheckBox x:Name="UnrestrictedResourceUsageCheckBox" Content="CPU使用率を制限しない（フルパワーで実行）" Checked="UnrestrictedResourceUsageCheckBox_Changed" Unchecked="UnrestrictedResourceUsageCheckBox_Changed"/>
                        <TextBlock Margin="28,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="既定では他の作業と競合したときに優先度を譲り、パソコンが重くなるのを防ぎます（パソコンが空いていれば速度は落ちません）。オンにすると常にフルパワーで実行し、その分速くなる可能性がありますが、実行中は他の作業が重くなることがあります。" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Expander Header="この回だけ探索の方針を変更する" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Padding="4,12,4,4" Spacing="12" MaxWidth="900">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="既定は「①設定」の「スケジュール設定」タブで保存した内容です。ここで変更しても、このプロジェクトの既定値そのものは変わりません（今回の自動作成にだけ適用されます）。"/>
                            <NumberBox x:Name="RunPolicyMaxStudentsPerTeacher" Header="一人の講師が同時に担当できる生徒数（既定は2人）" Minimum="1" Maximum="10" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="260"/>

                            <!-- ユーザー要望（checkpoint126）「探索方針について、設定だけでなく、自動作成
                                 ページの一時的なものでもできるようにしてほしい」への対応。「①設定」側と
                                 同じ並び替えUI（SchedulingPolicyRowsController・SchedulingPolicyRowViewModel
                                 を共有）をここにも設置し、この回だけ優先順位を一時的に変更できるようにした
                                 （「①設定」側の既定の並び順自体は変更しない）。 -->
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="探索方針（優先度の高い順）"/>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="行にカーソルを合わせると右端に表示される▲▼で並び替えできます。「考慮しない」以外を選ぶと自動的に一番上へ移動します。"/>
                            <ItemsControl x:Name="RunPolicyRowsList" ItemsSource="{x:Bind RunPolicyRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SchedulingPolicyRowViewModel">
                                        <Grid Margin="0,2,0,2" Padding="4" Background="Transparent" PointerEntered="RunPolicyRow_PointerEntered" PointerExited="RunPolicyRow_PointerExited">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayNumber, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <RadioButtons Grid.Column="2" ItemsSource="{x:Bind OptionLabels}" Loaded="RunPolicyOption_Loaded" SelectionChanged="RunPolicyOption_SelectionChanged" MaxColumns="3"/>
                                            <StackPanel x:Name="ArrowsPanel" Grid.Column="3" Orientation="Horizontal" Spacing="2" Visibility="Collapsed" VerticalAlignment="Center">
                                                <Button Content="▲" Padding="6,2" FontSize="10" Click="MoveRunPolicyRowUp_Click" Tag="{x:Bind}"/>
                                                <Button Content="▼" Padding="6,2" FontSize="10" Click="MoveRunPolicyRowDown_Click" Tag="{x:Bind}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <NumberBox x:Name="RunPolicyMaxConcurrentSeats" Header="⑧同時に使える座席数（0=考慮しない）" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="280"/>

                            <TextBlock FontWeight="SemiBold" Text="既定の時間（名目時間の2倍）になっても未配置が残っている場合"/>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="RunPolicyContinueBeyondNominalTimeYes" Content="そのまま完成するまで（または中断するまで）継続する" GroupName="RunPolicyContinueBeyondNominalTime"/>
                                <RadioButton x:Name="RunPolicyContinueBeyondNominalTimeNo" Content="そこで打ち切る（従来通り）" GroupName="RunPolicyContinueBeyondNominalTime"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <InfoBar
                        x:Name="BenchmarkingInfoBar"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Informational"
                        Title="このパソコンの性能を測定しています"
                        Message="初回のみ、時間割自動作成の前にごく短い測定（最大20秒程度）を行います。次回以降はこの測定を省略します。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RunButton" Content="時間割を自動作成" Click="Run_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="PauseButton" Content="一時停止" Click="Pause_Click" IsEnabled="False"/>
                        <Button x:Name="AcceptBestButton" Content="中断して現在の結果を採用" Click="AcceptBest_Click" IsEnabled="False"/>
                    </StackPanel>
                    <InfoBar
                        x:Name="PausedInfoBar"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Informational"
                        Title="一時停止中"
                        Message="「再開」を押すまで、次の探索を開始しません。" />
                    <Grid x:Name="ProgressPanel" ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="RunStageText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RunPercentText" Grid.Column="1" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </Grid>
                            <ProgressBar x:Name="RunProgressBar" Height="24" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="RunEtaText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <InfoBar
                                x:Name="ExtendingInfoBar"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Warning"
                                Title="少し時間を要しています"
                                Message="指定した品質の持ち時間内に完成しなかったため、途中で打ち切らずそのまま続けて探索しています。しばらくお待ちください。" />
                        </StackPanel>
                        <ProgressRing x:Name="RunProgress" Grid.Column="1" IsActive="False" Width="36" Height="36"/>
                    </Grid>
                    <TextBlock Text="品質設定に応じて、複数の戦略を順番に実行し、最も良い結果を採用します。進行中に「中断して現在の結果を採用」を押すと、その時点までに見つかった最良の結果を即座に提示します。「一時停止」を押すと、現在の探索が終わり次第、次の探索を始める前に停止します。「再開」を押すと、次の戦略から探索を開始します。" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="④ 時間割編集で結果を確認" Click="GoToEditor_Click"/>
                        <Button Content="⑥ 出力でExcel、PDFで結果を確認" Click="GoToOutput_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</local:WorkflowPageBase>
