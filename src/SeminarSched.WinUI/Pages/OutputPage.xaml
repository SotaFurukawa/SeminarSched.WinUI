<local:WorkflowPageBase x:Class="SeminarSched_WinUI.Pages.OutputPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SeminarSched_WinUI.Pages" NavigationCacheMode="Required" Loaded="Page_Loaded"><ScrollViewer><StackPanel Padding="24" Spacing="16"><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="6 出力"/><InfoBar x:Name="ProjectRequired"/><InfoBar x:Name="Status" IsClosable="True"/><TextBlock Text="全体時間割・生徒配布時間割・講師配布時間割（学年順）・講師配布時間割（講師別）・未配置+警告の一覧を出力します。講師配布時間割では、「通常授業で担当する生徒」及び「講習で担当する生徒」のみを抽出します。出力を行ったのち、時間割を編集、自動作成を行った場合は、再度出力ボタンを押してください。" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="GenerateButton" Content="Excel・PDFを出力" Click="Generate_Click" Style="{StaticResource AccentButtonStyle}"/><ProgressRing x:Name="Progress" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/><TextBlock x:Name="ProgressText" Text="出力中" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel><TextBlock Text="出力先は決まった保存フォルダー配下の新規フォルダーです。同名ファイルを確認なしで上書きしません。出力後、下の一覧または「出力フォルダーを開く」から確認できます。" TextWrapping="Wrap"/>
    <StackPanel x:Name="OutputFilesPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock FontWeight="SemiBold" Text="生成されたファイル"/>
        <ListView x:Name="GeneratedFiles" SelectionMode="Single" MaxHeight="240"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="選択したファイルを開く" Click="OpenSelectedFile_Click"/><Button Content="出力フォルダーを開く" Click="OpenOutputFolder_Click"/></StackPanel>
    </StackPanel>
</StackPanel></ScrollViewer></local:WorkflowPageBase>
