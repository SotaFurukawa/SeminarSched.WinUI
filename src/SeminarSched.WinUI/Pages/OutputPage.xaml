<local:WorkflowPageBase x:Class="SeminarSched_WinUI.Pages.OutputPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SeminarSched_WinUI.Pages" Loaded="Page_Loaded"><StackPanel Padding="24" Spacing="16"><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="⑥ 出力"/><InfoBar x:Name="ProjectRequired"/><InfoBar x:Name="Status" IsClosable="True"/><TextBlock Text="現在のDBを再検証し、全体時間割と未配置一覧をExcel・PDFへまとめて出力します。" TextWrapping="Wrap"/><Button x:Name="GenerateButton" Content="Excel・PDFを出力" Click="Generate_Click" Style="{StaticResource AccentButtonStyle}"/><ProgressRing x:Name="Progress" IsActive="False" HorizontalAlignment="Left"/><TextBlock Text="出力先は決まった保存フォルダー配下の新規フォルダーです。同名ファイルを確認なしで上書きしません。出力後、下の一覧または「出力フォルダーを開く」から確認できます。" TextWrapping="Wrap"/>
    <StackPanel x:Name="OutputFilesPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock FontWeight="SemiBold" Text="生成されたファイル"/>
        <ListView x:Name="GeneratedFiles" SelectionMode="Single" MaxHeight="240"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="選択したファイルを開く" Click="OpenSelectedFile_Click"/><Button Content="出力フォルダーを開く" Click="OpenOutputFolder_Click"/></StackPanel>
    </StackPanel>
</StackPanel></local:WorkflowPageBase>
