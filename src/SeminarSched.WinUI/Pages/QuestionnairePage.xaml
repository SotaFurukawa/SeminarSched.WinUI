<local:WorkflowPageBase x:Class="SeminarSched_WinUI.Pages.QuestionnairePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SeminarSched_WinUI.Pages" NavigationCacheMode="Required" Loaded="Page_Loaded">
    <ScrollViewer><StackPanel MaxWidth="720" Padding="24" HorizontalAlignment="Left" Spacing="16">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="2 アンケート作成"/>
        <InfoBar x:Name="ProjectRequired"/>
        <InfoBar x:Name="Status" IsClosable="True"/>
        <TextBlock Text="設定した開校日・コマ・科目から、生徒用・講師用のGoogleフォーム作成キットを作成します。フォーム回答(Google spreadsheet)を「3.アンケート取込」でそのまま取り込むことができます。" TextWrapping="Wrap"/>
        <TextBox x:Name="StudentTitleBox" Header="生徒用フォーム名"/>
        <CalendarDatePicker x:Name="StudentDeadlinePicker" Header="生徒用 回答締切"/>
        <TextBox x:Name="TeacherTitleBox" Header="講師用フォーム名（勤務可能日時）"/>
        <CalendarDatePicker x:Name="TeacherDeadlinePicker" Header="講師用 回答締切"/>
        <TextBox x:Name="ContactBox" Header="問い合わせ先" Text="校舎へお問い合わせください"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="GenerateButton" Content="作成キットを保存" Click="Generate_Click" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="作成手順" Click="Guide_Click"/>
        </StackPanel>
        <StackPanel x:Name="ResultPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <Button x:Name="OpenFolderButton" Content="保存先を開く" Click="OpenFolder_Click"/>
        </StackPanel>
        <TextBlock Text="生成されたCode.gsをGoogle Apps Scriptへ貼り付けて実行します。回答データを外部サービスへ自動送信しません。" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
</local:WorkflowPageBase>
