<local:WorkflowPageBase
    x:Class="SeminarSched_WinUI.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeminarSched_WinUI.Pages"
    Loaded="Page_Loaded">
    <ScrollViewer><StackPanel MaxWidth="960" Padding="24" HorizontalAlignment="Left" Spacing="16">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="① 設定"/>
        <InfoBar x:Name="ProjectRequired"/>
        <InfoBar x:Name="Status" IsClosable="True"/>
        <TextBlock Text="プロジェクト、開校日、コマ、科目、生徒・講師の共通基本情報を設定します。" TextWrapping="Wrap"/>
        <TabView x:Name="Tabs">
            <TabViewItem Header="プロジェクト"><StackPanel Padding="16" Spacing="10"><TextBlock x:Name="ProjectTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ProjectPeriod"/><TextBlock Text="新規作成・読込み・バックアップ・復元はホームから操作できます。" TextWrapping="Wrap"/><TextBlock Margin="0,12,0,0" FontSize="18" FontWeight="SemiBold" Text="共通基本情報Excel"/><TextBlock Text="生徒・講師・科目・講師対応科目・受講希望の5シートを一括で出力・検証・反映します。" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="現在データをExcelへ出力" Click="ExportMasterWorkbook_Click"/><Button Content="Excelを検証して取込み" Click="ImportMasterWorkbook_Click"/></StackPanel></StackPanel></TabViewItem>
            <TabViewItem Header="生徒"><StackPanel Padding="16" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StudentId" Header="生徒ID"/><TextBox x:Name="StudentName" Grid.Column="1" Header="氏名"/><TextBox x:Name="StudentGrade" Grid.Column="2" Header="学年"/><NumberBox x:Name="StudentMaximum" Grid.Column="3" Header="最大連続コマ" Minimum="1" Value="2"/><Button Grid.Column="4" VerticalAlignment="Bottom" Content="保存" Click="AddStudent_Click"/></Grid><TextBox x:Name="StudentNote" Header="備考"/><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="StudentAllowGap" Content="空きコマを許可"/><CheckBox x:Name="StudentActive" Content="有効" IsChecked="True"/><Button Content="新規入力" Click="NewStudent_Click"/></StackPanel><TextBlock Text="一覧を選択すると編集できます。使用停止する場合は「有効」を外して保存します。"/><TextBox x:Name="StudentSearch" PlaceholderText="ID・氏名・学年で検索" TextChanged="StudentSearch_TextChanged"/><ListView x:Name="Students" SelectionChanged="Students_SelectionChanged"/></StackPanel></TabViewItem>
            <TabViewItem Header="講師"><StackPanel Padding="16" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TeacherId" Header="講師ID"/><TextBox x:Name="TeacherName" Grid.Column="1" Header="氏名"/><Button Grid.Column="2" VerticalAlignment="Bottom" Content="保存" Click="AddTeacher_Click"/></Grid><TextBox x:Name="TeacherNote" Header="備考"/><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="TeacherAllowGap" Content="空きコマを許可"/><CheckBox x:Name="TeacherActive" Content="有効" IsChecked="True"/><Button Content="新規入力" Click="NewTeacher_Click"/></StackPanel><TextBox x:Name="TeacherSearch" PlaceholderText="ID・氏名で検索" TextChanged="TeacherSearch_TextChanged"/><ListView x:Name="Teachers" SelectionChanged="Teachers_SelectionChanged"/></StackPanel></TabViewItem>
            <TabViewItem Header="科目"><StackPanel Padding="16" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SubjectCode" Header="コード"/><TextBox x:Name="SubjectName" Grid.Column="1" Header="科目名"/><TextBox x:Name="SubjectShort" Grid.Column="2" Header="略称"/><TextBox x:Name="SubjectLevel" Grid.Column="3" Header="校種"/><NumberBox x:Name="SubjectOrder" Grid.Column="4" Header="順序" Minimum="1" Value="1"/><Button Grid.Column="5" VerticalAlignment="Bottom" Content="保存" Click="AddSubject_Click"/></Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="SubjectActive" Content="有効" IsChecked="True"/><Button Content="新規入力" Click="NewSubject_Click"/></StackPanel><TextBox x:Name="SubjectSearch" PlaceholderText="コード・科目名・校種で検索" TextChanged="SubjectSearch_TextChanged"/><ListView x:Name="Subjects" SelectionChanged="Subjects_SelectionChanged"/></StackPanel></TabViewItem>
            <TabViewItem Header="担当設定"><StackPanel Padding="16" Spacing="12"><TextBlock FontSize="18" FontWeight="SemiBold" Text="講師対応科目"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="QualificationTeacher" Header="講師"/><ComboBox x:Name="QualificationSubject" Grid.Column="1" Header="科目"/><Button Grid.Column="2" VerticalAlignment="Bottom" Content="保存" Click="SaveQualification_Click"/></Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="QualificationCanTeach" Content="指導可能" IsChecked="True"/><TextBox x:Name="QualificationNote" Width="420" Header="備考"/></StackPanel><ListView x:Name="Qualifications"/>
                <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="複数の講師・科目へ一括設定"/>
                <TextBlock Text="講師と科目をそれぞれ複数選び、すべての組み合わせへ指導可否をまとめて設定します。" TextWrapping="Wrap"/>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="講師"/><ListView x:Name="BulkQualificationTeachers" SelectionMode="Multiple" MaxHeight="160" DisplayMemberPath="Display"/></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="科目"/><ListView x:Name="BulkQualificationSubjects" SelectionMode="Multiple" MaxHeight="160" DisplayMemberPath="Display"/></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="BulkQualificationCanTeach" Content="指導可能" IsChecked="True"/><Button Content="選択した組み合わせへ一括設定" Click="SaveBulkQualifications_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
                <TextBlock Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold" Text="通常授業の担当設定"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="RegularStudent" Header="生徒"/><ComboBox x:Name="RegularSubject" Grid.Column="1" Header="科目"/><ComboBox x:Name="RegularTeacher" Grid.Column="2" Header="通常担当講師（任意）"/><NumberBox x:Name="RegularPriority" Grid.Column="3" Header="優先度 1～5" Minimum="1" Maximum="5" Value="3"/><Button Grid.Column="4" VerticalAlignment="Bottom" Content="保存" Click="SaveRegularLesson_Click"/></Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="RegularOneToOne" Content="1対1必須"/><TextBox x:Name="RegularNote" Width="420" Header="備考"/></StackPanel><ListView x:Name="RegularLessons"/></StackPanel></TabViewItem>
            <TabViewItem Header="コマ・開校日"><StackPanel Padding="16" Spacing="12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="コマ設定"/>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SlotCode" Header="コード"/><TextBox x:Name="SlotName" Grid.Column="1" Header="表示名"/><TimePicker x:Name="SlotStart" Grid.Column="2" Header="開始" ClockIdentifier="24HourClock"/><TimePicker x:Name="SlotEnd" Grid.Column="3" Header="終了" ClockIdentifier="24HourClock"/><NumberBox x:Name="SlotOrder" Grid.Column="4" Header="順序" Minimum="1" Value="1"/><Button Grid.Column="5" VerticalAlignment="Bottom" Content="保存" Click="AddSlot_Click"/>
                </Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="SlotActive" Content="有効" IsChecked="True"/><Button Content="新規入力" Click="NewSlot_Click"/></StackPanel><ListView x:Name="TimeSlots" SelectionChanged="TimeSlots_SelectionChanged"/>
                <TextBlock Margin="0,12,0,0" FontSize="18" FontWeight="SemiBold" Text="開校日・休校日"/>
                <TextBlock Text="日付を選び、開校または休校へ切り替えます。「開校」は現在有効な全コマをその日に設定します。" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="開校（全コマ）" Click="SetOpenDay_Click"/><Button Content="休校" Click="SetClosedDay_Click"/></StackPanel>
                <ListView x:Name="CourseDays" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Width="120" Text="{Binding Date}"/><TextBlock Width="60" Text="{Binding StatusLabel}"/><TextBlock Text="{Binding SlotSummary}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
            </StackPanel></TabViewItem>
        </TabView>
    </StackPanel></ScrollViewer>
</local:WorkflowPageBase>
