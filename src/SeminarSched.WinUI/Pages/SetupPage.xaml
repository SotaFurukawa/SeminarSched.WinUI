<local:WorkflowPageBase
    x:Class="SeminarSched_WinUI.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeminarSched_WinUI.Pages"
    xmlns:vm="using:SeminarSched_WinUI"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer><StackPanel Padding="24" Spacing="16">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="1 プロジェクト設定"/>
        <InfoBar x:Name="ProjectRequired"/>
        <InfoBar x:Name="Status" IsClosable="True"/>
        <TextBlock Text="プロジェクト、開校日、コマ、科目、生徒・講師の共通基本情報を設定します。" TextWrapping="Wrap"/>
        <!-- ユーザー指摘（checkpoint122）「個々のボタンの幅をもう少し広げてほしい」「ボタンの文字を
             改行してもらいましたが、やはり1行で表示したい。そうすると少し右側にはみ出るかもしれないが、
             Excelのシートを選べるような感じで右側に移動できるようにしておいてほしい」への対応。
             checkpoint120で追加した2行折り返し（TextWrapping）は撤回し、各タブの見出しは1行表示へ
             戻す。TabWidthMode="SizeToContent"にすることで、タブの合計幅がページ幅を超えたときに
             WinUI標準の左右スクロールボタンが自動的に現れる（Excelのシートタブと同様の挙動）。
             MinWidthで各タブに最低限の余裕を持たせ、詰まった印象にならないようにした。
             「科目・出力設定は優先度が低いので、右端に持ってくる」との指摘を受け、この2つを
             末尾へ並べ替えた。 -->
        <TabView x:Name="Tabs" TabWidthMode="SizeToContent" IsAddTabButtonVisible="False" SelectionChanged="Tabs_SelectionChanged">
            <TabView.Resources>
                <Style TargetType="TabViewItem">
                    <Setter Property="MinWidth" Value="120"/>
                </Style>
            </TabView.Resources>
            <TabViewItem Header="生徒"><StackPanel Padding="16" Spacing="10"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="新規で通期の生徒を追加できます。ホームの「Excelで基本情報を編集」からでも追加できます。"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StudentId" Header="生徒ID" IsEnabled="False"/><TextBox x:Name="StudentName" Grid.Column="1" Header="氏名"/><TextBox x:Name="StudentGrade" Grid.Column="2" Header="学年"/><NumberBox x:Name="StudentMaximum" Grid.Column="3" Header="最大連続コマ" Minimum="1" Value="2"/><Button Grid.Column="4" VerticalAlignment="Bottom" Content="保存" Click="AddStudent_Click"/></Grid><TextBox x:Name="StudentNote" Header="備考" Width="420" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="StudentAllowGap" Content="空きコマを許可"/><CheckBox x:Name="StudentActive" Content="在籍中" IsChecked="True" Checked="StudentActive_Changed" Unchecked="StudentActive_Changed"/><Button Content="新規入力" Click="NewStudent_Click"/></StackPanel><TextBlock Text="一覧を選択すると編集できます。「在籍中」のチェックはそのまま即座に保存されます。生徒IDは自動的に割り振られ、変更できません。"/><TextBox x:Name="StudentSearch" PlaceholderText="ID・氏名・学年で検索" TextChanged="StudentSearch_TextChanged" Width="320" HorizontalAlignment="Left"/>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="生徒ID"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="生徒氏名"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="学年"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="最大連続コマ数"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="状態"/></Grid>
                <ListView x:Name="Students" SelectionChanged="Students_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.ExternalId}"/><TextBlock Grid.Column="1" Text="{Binding Value.Name}"/><TextBlock Grid.Column="2" Text="{Binding Value.Grade}"/><TextBlock Grid.Column="3" Text="{Binding Value.DefaultMaxConsecutiveSlots}"/><TextBlock Grid.Column="4" Text="{Binding StatusText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel></TabViewItem>
            <TabViewItem Header="講師"><StackPanel Padding="16" Spacing="10"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="新規で通期の講師を追加できます。ホームの「Excelで基本情報を編集」からでも追加できます。"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TeacherId" Header="講師ID" IsEnabled="False"/><TextBox x:Name="TeacherName" Grid.Column="1" Header="氏名"/><Button Grid.Column="2" VerticalAlignment="Bottom" Content="保存" Click="AddTeacher_Click"/></Grid><TextBox x:Name="TeacherNote" Header="備考" Width="420" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="TeacherAllowGap" Content="空きコマを許可"/><CheckBox x:Name="TeacherActive" Content="在籍中" IsChecked="True" Checked="TeacherActive_Changed" Unchecked="TeacherActive_Changed"/><Button Content="新規入力" Click="NewTeacher_Click"/></StackPanel><TextBlock Text="一覧を選択すると編集できます。「在籍中」のチェックはそのまま即座に保存されます。講師IDは自動的に割り振られ、変更できません。"/><TextBox x:Name="TeacherSearch" PlaceholderText="ID・氏名で検索" TextChanged="TeacherSearch_TextChanged" Width="320" HorizontalAlignment="Left"/>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="講師ID"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="講師氏名"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="状態"/></Grid>
                <ListView x:Name="Teachers" SelectionChanged="Teachers_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.ExternalId}"/><TextBlock Grid.Column="1" Text="{Binding Value.Name}"/><TextBlock Grid.Column="2" Text="{Binding StatusText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel></TabViewItem>
            <TabViewItem Header="講師指導可能科目"><StackPanel Padding="16" Spacing="12">
                <!-- ユーザー要望（checkpoint142）「講師指導可能科目について、表以外は消す。表だけで
                     十分です」への対応。従来は講師・科目・指導可否・保存の入力フォームと備考欄を表の上に
                     置いていたが、表の○クリックで指導可否は直接切り替えられるため実質的に不要だった。
                     備考編集だけは他に手段が無くなるため、○セルの右クリック/長押し（RightTapped）で
                     備考編集ダイアログ（QualificationCell_RightTapped）を出す形に移した。 -->
                <!-- ユーザー要望（checkpoint128）「横にスライドして動かしても、講師ID、講師氏名は左側に
                     固定してほしい。縦にスクロールした場合に、科目が動かないのも同様に」への対応。
                     Excelのウィンドウ枠固定と同じ4分割構成（角・見出し・左列・本体）にし、本体
                     （QualificationMatrixBodyScroll）のスクロールに合わせて見出し・左列のオフセットを
                     コードビハインドから追従させる（QualificationMatrixBodyScroll_ViewChanged）。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="QualificationMatrixCorner" Grid.Row="0" Grid.Column="0"/>
                    <ScrollViewer x:Name="QualificationMatrixHeaderScroll" Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsHitTestVisible="False">
                        <Grid x:Name="QualificationMatrixHeader"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="QualificationMatrixLeftScroll" Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" MaxHeight="480" IsHitTestVisible="False">
                        <Grid x:Name="QualificationMatrixLeft"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="QualificationMatrixBodyScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="480" ViewChanged="QualificationMatrixBodyScroll_ViewChanged">
                        <Grid x:Name="QualificationMatrixBody"/>
                    </ScrollViewer>
                </Grid>
            </StackPanel></TabViewItem>
            <TabViewItem Header="通常授業担当設定"><StackPanel Padding="16" Spacing="12">
                <!-- ユーザー指摘（checkpoint129）「画像③も同様で離れているのと、1対1を同じ段に持ってくる」
                     への対応。1対1必須チェックボックスを生徒・科目などと同じ行へ移動し、列をAutoへ変更して
                     各コントロールへ明示的なWidthを与えた（checkpoint121と同種のComboBox幅問題の回避）。 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="RegularStudent" Header="生徒" Width="200"/>
                    <ComboBox x:Name="RegularSubject" Grid.Column="1" Header="科目" Width="160"/>
                    <ComboBox x:Name="RegularTeacher" Grid.Column="2" Header="通常担当講師（任意）" Width="220"/>
                    <NumberBox x:Name="RegularPriority" Grid.Column="3" Header="優先度 1～5" Minimum="1" Maximum="5" Value="3" Width="100"/>
                    <CheckBox x:Name="RegularOneToOne" Grid.Column="4" Content="1対1必須" VerticalAlignment="Bottom"/>
                    <Button Grid.Column="5" VerticalAlignment="Bottom" Content="保存" Click="SaveRegularLesson_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="16"><TextBox x:Name="RegularNote" Width="420" Header="備考"/></StackPanel>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/><ColumnDefinition Width="160"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="生徒氏名"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="科目"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="通常担当講師"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="優先度"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="1対1"/></Grid>
                <ListView x:Name="RegularLessons">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/><ColumnDefinition Width="160"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StudentName}"/><TextBlock Grid.Column="1" Text="{Binding SubjectName}"/><TextBlock Grid.Column="2" Text="{Binding TeacherName}"/><TextBlock Grid.Column="3" Text="{Binding Priority}"/><TextBlock Grid.Column="4" Text="{Binding OneToOneText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel></TabViewItem>
            <TabViewItem Header="コマ・開校日"><StackPanel Padding="16" Spacing="12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="コマ設定"/>
                <!-- ユーザー要望（checkpoint142）「コマ情報の変更について、有効のチェックボックスは
                     保存よりも前に来るように」への対応。有効チェックボックスを保存ボタンの直前の列へ
                     移動した（即時保存の挙動自体はSlotActive_Changedのまま変更なし）。 -->
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SlotCode" Header="コード"/><TextBox x:Name="SlotName" Grid.Column="1" Header="表示名"/>
                    <ComboBox x:Name="SlotStartTime" Grid.Column="2" Header="開始" IsEditable="True" PlaceholderText="09:00"/>
                    <ComboBox x:Name="SlotEndTime" Grid.Column="3" Header="終了" IsEditable="True" PlaceholderText="10:00"/>
                    <CheckBox x:Name="SlotActive" Grid.Column="4" VerticalAlignment="Bottom" Content="有効" IsChecked="True" Checked="SlotActive_Changed" Unchecked="SlotActive_Changed"/>
                    <Button Grid.Column="5" VerticalAlignment="Bottom" Content="保存" Click="AddSlot_Click"/>
                </Grid><StackPanel Orientation="Horizontal" Spacing="16"><Button Content="新規入力" Click="NewSlot_Click"/></StackPanel>
                <TextBlock Text="▲▼で表示順を並べ替えられます（動かすとすぐに保存されます）。右端の×で削除できます（時間割配置等で使用中のコマは削除できません）。" TextWrapping="Wrap"/>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="コード"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="表示名"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="開始"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="終了"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="状態"/>
                </Grid>
                <ListView x:Name="TimeSlots" SelectionChanged="TimeSlots_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.Code}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value.DisplayName}"/>
                                <TextBlock Grid.Column="2" Text="{Binding StartText}"/>
                                <TextBlock Grid.Column="3" Text="{Binding EndText}"/>
                                <TextBlock Grid.Column="4" Text="{Binding StatusText}"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                    <Button Content="▲" Padding="8,2" Tag="{Binding Value.Id}" Click="MoveSlotUp_Click"/>
                                    <Button Content="▼" Padding="8,2" Tag="{Binding Value.Id}" Click="MoveSlotDown_Click"/>
                                    <Button Content="×" Padding="10,2" Tag="{Binding Value.Id}" Click="DeleteSlot_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Margin="0,12,0,0" FontSize="18" FontWeight="SemiBold" Text="開校日・休校日カレンダー"/>
                <TextBlock x:Name="CourseDayPeriodLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="日付をクリックまたはチェックで選び、下の一括操作かコマのチェックで反映します。変更はすぐに保存されます。" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="休校日を全て選択" Click="CalendarSelectClosedDays_Click"/>
                    <Button Content="開校日を全て選択" Click="CalendarSelectOpenDays_Click"/>
                    <ComboBox x:Name="CalendarWeekday" Width="110" SelectedIndex="0"><ComboBoxItem Content="日曜日"/><ComboBoxItem Content="月曜日"/><ComboBoxItem Content="火曜日"/><ComboBoxItem Content="水曜日"/><ComboBoxItem Content="木曜日"/><ComboBoxItem Content="金曜日"/><ComboBoxItem Content="土曜日"/></ComboBox>
                    <Button Content="○曜日を選択" Click="CalendarSelectWeekday_Click"/>
                    <Button Content="すべて選択" Click="CalendarSelectAll_Click"/>
                    <Button Content="選択解除" Click="CalendarClearSelection_Click"/>
                    <TextBlock x:Name="CalendarSelectionCount" VerticalAlignment="Center" Text="0件選択中"/>
                    <Button Content="選択日を休校" Click="CalendarCloseSelected_Click" Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="選択日を開校" Click="CalendarOpenSelected_Click" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
                <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="選択日に使用するコマ"/>
                        <StackPanel x:Name="CalendarSlotTogglePanel" Orientation="Horizontal" Spacing="8"/>
                        <Button Content="全コマ" Click="CalendarAllSlots_Click"/>
                    </StackPanel>
                </Border>
                <Grid x:Name="CalendarWeekdayHeader" ColumnSpacing="2"/>
                <Grid x:Name="CourseDayCalendar" ColumnSpacing="2" RowSpacing="2"/>
            </StackPanel></TabViewItem>
            <TabViewItem Header="スケジュール設定">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="7 最適化探索の方針設定"/>
                    <TextBlock Text="ここで保存した内容がこのプロジェクトの既定値になります。5 時間割自動作成の画面でも、その回だけの一時的な変更ができます。" TextWrapping="Wrap"/>
                    <!-- ユーザー指摘（checkpoint128）「同時に使える座席数上限」追加時に、NumberBoxの
                         HeaderはControl自身の幅（140px）に収まる範囲でしか表示されず、長い説明文が
                         途中で切れてしまうことが実機で判明した。説明文はControlの外の独立した
                         TextBlockへ分離し、NumberBox自体は入力欄として最小限の幅に留める。 -->
                    <TextBlock Text="一人の講師が同時に担当できる生徒数（既定は2人）" TextWrapping="Wrap"/>
                    <NumberBox x:Name="PolicyMaxStudentsPerTeacher" Minimum="1" Maximum="10" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="140"/>
                    <!-- ユーザー要望（checkpoint128）「⑧同時に使える座席数について、⑧としての扱いではなく、
                         探索方針の上に、一人の講師が担当できる生徒数の下に並べて書いてほしい」への対応。 -->
                    <TextBlock Margin="0,8,0,0" Text="同時に使える座席数上限（0であれば無制限）" TextWrapping="Wrap"/>
                    <NumberBox x:Name="PolicyMaxConcurrentSeats" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="140"/>

                    <!-- ユーザー要望（checkpoint123）「自動作成のオプション機能（探索方針）について、
                         この優先度を変えられるようにしたい。校舎によっては、一日に入るコマ数＞遅めの
                         時間に入れることを優先の場合があり、その逆も同様である」への対応。以前は
                         ①〜⑦の固定順・固定番号だったが、PolicyRows（ObservableCollection）を
                         ItemsControlで表示し、行にカーソルを乗せると右端に上下矢印が現れて並び替え
                         られるようにした（コードビハインドのMovePolicyRowUp/Down_Click）。番号は
                         並び替えに応じてDisplayNumberへ都度再計算する。「考慮しない」以外が選択
                         されると自動的に一番上へ移動する（PolicyOption_SelectionChanged）。 -->
                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="探索方針（優先度の高い順）"/>
                    <!-- ユーザー要望（checkpoint129）「探索方針について、スライドもできるようにしてほしい」
                         への対応。ItemsControlからListView（CanReorderItems+AllowDrop）へ変更し、
                         ▲▼ボタンに加えて行をドラッグ（スライド）して並び替えられるようにした。
                         ドラッグによる並び替えもObservableCollection.Move()を使うため、▲▼と同じく
                         並び替え後にDisplayNumberの再計算とコンテナの再構築（RadioButtonの選択状態の
                         再描画不具合の回避）が必要（PolicyRowsList_DragItemsCompleted）。 -->
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="行をドラッグするか、カーソルを合わせると右端に表示される▲▼で並び替えできます。「考慮しない」以外を選ぶと自動的に一番上へ移動します。"/>
                    <ListView x:Name="PolicyRowsList" ItemsSource="{x:Bind PolicyRows}" SelectionMode="None" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="PolicyRowsList_DragItemsCompleted">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchedulingPolicyRowViewModel">
                                <Grid Margin="0,2,0,2" Padding="4" Background="Transparent" PointerEntered="PolicyRow_PointerEntered" PointerExited="PolicyRow_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayNumber, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Grid Grid.Column="2" ColumnSpacing="12" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" Content="{x:Bind Option0Label}" GroupName="{x:Bind GroupKey}" Tag="0" Loaded="PolicyOption_Loaded" Checked="PolicyOption_Checked"/>
                                        <RadioButton Grid.Column="1" Content="{x:Bind Option1Label}" GroupName="{x:Bind GroupKey}" Tag="1" Loaded="PolicyOption_Loaded" Checked="PolicyOption_Checked"/>
                                        <RadioButton Grid.Column="2" Content="{x:Bind Option2Label}" Visibility="{x:Bind Option2Visibility}" GroupName="{x:Bind GroupKey}" Tag="2" Loaded="PolicyOption_Loaded" Checked="PolicyOption_Checked"/>
                                    </Grid>
                                    <StackPanel x:Name="ArrowsPanel" Grid.Column="3" Orientation="Horizontal" Spacing="2" Visibility="Collapsed" VerticalAlignment="Center">
                                        <Button Content="▲" Padding="6,2" FontSize="10" Click="MovePolicyRowUp_Click" Tag="{x:Bind}"/>
                                        <Button Content="▼" Padding="6,2" FontSize="10" Click="MovePolicyRowDown_Click" Tag="{x:Bind}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="既定の時間（名目時間の2倍）になっても未配置が残っている場合"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyContinueBeyondNominalTimeYes" Content="そのまま完成するまで（または中断するまで）継続する" GroupName="PolicyContinueBeyondNominalTime" IsChecked="True"/>
                        <RadioButton x:Name="PolicyContinueBeyondNominalTimeNo" Content="そこで打ち切る（従来通り）" GroupName="PolicyContinueBeyondNominalTime"/>
                    </StackPanel>

                    <Button Content="保存" Click="SaveSchedulingPolicy_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabViewItem>
            <TabViewItem Header="科目"><StackPanel Padding="16" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SubjectCode" Header="コード"/><TextBox x:Name="SubjectName" Grid.Column="1" Header="科目名"/><TextBox x:Name="SubjectShort" Grid.Column="2" Header="略称" PlaceholderText="1文字（空欄で自動推定）" MaxLength="1"/><ComboBox x:Name="SubjectLevel" Grid.Column="3" Header="校種" IsEditable="True" PlaceholderText="校種を選択または入力"><ComboBoxItem Content="小学校"/><ComboBoxItem Content="中学校"/><ComboBoxItem Content="高等学校"/></ComboBox><NumberBox x:Name="SubjectOrder" Grid.Column="4" Header="順序" Minimum="1" Value="1"/><Button Grid.Column="5" VerticalAlignment="Bottom" Content="保存" Click="AddSubject_Click"/></Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="SubjectActive" Content="有効" IsChecked="True" Checked="SubjectActive_Changed" Unchecked="SubjectActive_Changed"/><Button Content="新規入力" Click="NewSubject_Click"/></StackPanel><TextBox x:Name="SubjectSearch" PlaceholderText="コード・科目名・校種で検索" TextChanged="SubjectSearch_TextChanged" Width="320" HorizontalAlignment="Left"/>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="順序"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="コード"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="科目名"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="略称"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="校種"/><TextBlock Grid.Column="5" FontWeight="SemiBold" Text="状態"/></Grid>
                <ListView x:Name="Subjects" SelectionChanged="Subjects_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.SortOrder}"/><TextBlock Grid.Column="1" Text="{Binding Value.Code}"/><TextBlock Grid.Column="2" Text="{Binding Value.DisplayName}"/><TextBlock Grid.Column="3" Text="{Binding Value.ShortName}"/><TextBlock Grid.Column="4" Text="{Binding Value.SchoolLevel}"/><TextBlock Grid.Column="5" Text="{Binding StatusText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel></TabViewItem>
            <TabViewItem Header="出力設定">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="6 出力の書式設定"/>
                    <TextBlock Text="PDFの用紙サイズ・向き・余白、出力ファイル名の規則（{project}=プロジェクト名、{report}=帳票名、{date}=出力日）、主な塗り色を設定します。" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <ComboBox x:Name="OutputPaperSize" Header="用紙サイズ" Grid.Row="0" Grid.Column="0"><ComboBoxItem Content="A4"/><ComboBoxItem Content="A3"/></ComboBox>
                        <ComboBox x:Name="OutputOrientation" Header="向き" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="横（landscape）" Tag="landscape"/><ComboBoxItem Content="縦（portrait）" Tag="portrait"/></ComboBox>
                        <NumberBox x:Name="OutputMarginMm" Header="余白（mm）" Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="30" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                    <TextBox x:Name="OutputFileNamePattern" Header="ファイル名規則" PlaceholderText="{}{project}-{report}" Width="420" HorizontalAlignment="Left"/>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="塗り色（#RRGGBB形式）"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="200"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputClosedColor" Header="休校日" Grid.Column="0"/>
                        <TextBox x:Name="OutputUnavailableColor" Header="勤務不可コマ" Grid.Column="1"/>
                        <TextBox x:Name="OutputGroupColor" Header="集団授業" Grid.Column="2"/>
                    </Grid>
                    <Button Content="保存" Click="SaveOutputSettings_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabViewItem>
        </TabView>
    </StackPanel></ScrollViewer>
</local:WorkflowPageBase>
