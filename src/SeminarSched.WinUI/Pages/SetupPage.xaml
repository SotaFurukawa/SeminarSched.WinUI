<local:WorkflowPageBase
    x:Class="SeminarSched_WinUI.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeminarSched_WinUI.Pages"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer><StackPanel MaxWidth="960" Padding="24" HorizontalAlignment="Left" Spacing="16">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="① 設定"/>
        <InfoBar x:Name="ProjectRequired"/>
        <InfoBar x:Name="Status" IsClosable="True"/>
        <TextBlock Text="プロジェクト、開校日、コマ、科目、生徒・講師の共通基本情報を設定します。" TextWrapping="Wrap"/>
        <!-- ユーザー指摘（checkpoint122）「個々のボタンの幅をもう少し広げてほしい」「ボタンの文字を
             改行してもらいましたが、やはり1行で表示したい。そうすると少し右側にはみ出るかもしれないが、
             Excelのシートを選べるような感じで右側に移動できるようにしておいてほしい」への対応。
             checkpoint120で追加した2行折り返し（TextWrapping）は撤回し、各タブの見出しは1行表示へ
             戻す。TabWidthMode="SizeToContent"にすることで、タブの合計幅がページ幅を超えたときに
             WinUI標準の左右スクロールボタンが自動的に現れる（Excelのシートタブと同様の挙動）。
             MinWidthで各タブに最低限の余裕を持たせ、詰まった印象にならないようにした。
             「科目・出力設定は優先度が低いので、右端に持ってくる」との指摘を受け、この2つを
             末尾へ並べ替えた。 -->
        <TabView x:Name="Tabs" TabWidthMode="SizeToContent" SelectionChanged="Tabs_SelectionChanged">
            <TabView.Resources>
                <Style TargetType="TabViewItem">
                    <Setter Property="MinWidth" Value="120"/>
                </Style>
            </TabView.Resources>
            <TabViewItem Header="生徒"><StackPanel Padding="16" Spacing="10"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="新規で通期の生徒を追加できます。ホームの「Excelで基本情報を編集」からでも追加できます。"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StudentId" Header="生徒ID" IsEnabled="False"/><TextBox x:Name="StudentName" Grid.Column="1" Header="氏名"/><TextBox x:Name="StudentGrade" Grid.Column="2" Header="学年"/><NumberBox x:Name="StudentMaximum" Grid.Column="3" Header="最大連続コマ" Minimum="1" Value="2"/><Button Grid.Column="4" VerticalAlignment="Bottom" Content="保存" Click="AddStudent_Click"/></Grid><TextBox x:Name="StudentNote" Header="備考"/><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="StudentAllowGap" Content="空きコマを許可"/><CheckBox x:Name="StudentActive" Content="在籍中" IsChecked="True" Checked="StudentActive_Changed" Unchecked="StudentActive_Changed"/><Button Content="新規入力" Click="NewStudent_Click"/></StackPanel><TextBlock Text="一覧を選択すると編集できます。「在籍中」のチェックはそのまま即座に保存されます。生徒IDは自動的に割り振られ、変更できません。"/><TextBox x:Name="StudentSearch" PlaceholderText="ID・氏名・学年で検索" TextChanged="StudentSearch_TextChanged"/>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="生徒ID"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="生徒氏名"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="学年"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="状態"/></Grid>
                <ListView x:Name="Students" SelectionChanged="Students_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.ExternalId}"/><TextBlock Grid.Column="1" Text="{Binding Value.Name}"/><TextBlock Grid.Column="2" Text="{Binding Value.Grade}"/><TextBlock Grid.Column="3" Text="{Binding StatusText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel></TabViewItem>
            <TabViewItem Header="講師"><StackPanel Padding="16" Spacing="10"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="新規で通期の講師を追加できます。ホームの「Excelで基本情報を編集」からでも追加できます。"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TeacherId" Header="講師ID" IsEnabled="False"/><TextBox x:Name="TeacherName" Grid.Column="1" Header="氏名"/><Button Grid.Column="2" VerticalAlignment="Bottom" Content="保存" Click="AddTeacher_Click"/></Grid><TextBox x:Name="TeacherNote" Header="備考"/><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="TeacherAllowGap" Content="空きコマを許可"/><CheckBox x:Name="TeacherActive" Content="在籍中" IsChecked="True" Checked="TeacherActive_Changed" Unchecked="TeacherActive_Changed"/><Button Content="新規入力" Click="NewTeacher_Click"/></StackPanel><TextBlock Text="一覧を選択すると編集できます。「在籍中」のチェックはそのまま即座に保存されます。講師IDは自動的に割り振られ、変更できません。"/><TextBox x:Name="TeacherSearch" PlaceholderText="ID・氏名で検索" TextChanged="TeacherSearch_TextChanged"/>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="講師ID"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="講師氏名"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="状態"/></Grid>
                <ListView x:Name="Teachers" SelectionChanged="Teachers_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.ExternalId}"/><TextBlock Grid.Column="1" Text="{Binding Value.Name}"/><TextBlock Grid.Column="2" Text="{Binding StatusText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel></TabViewItem>
            <TabViewItem Header="講師指導可能科目"><StackPanel Padding="16" Spacing="12"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="QualificationTeacher" Header="講師"/><ComboBox x:Name="QualificationSubject" Grid.Column="1" Header="科目"/><Button Grid.Column="2" VerticalAlignment="Bottom" Content="保存" Click="SaveQualification_Click"/></Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="QualificationCanTeach" Content="指導可能" IsChecked="True"/><TextBox x:Name="QualificationNote" Width="420" Header="備考"/></StackPanel>
                <TextBlock Text="表の○をクリックすると指導可能／不可を切り替えられます（備考は上のフォームで個別に設定してください）。" TextWrapping="Wrap"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <Grid x:Name="QualificationMatrix" ColumnSpacing="2" RowSpacing="2"/>
                </ScrollViewer>
            </StackPanel></TabViewItem>
            <TabViewItem Header="通常授業担当設定"><StackPanel Padding="16" Spacing="12"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="RegularStudent" Header="生徒"/><ComboBox x:Name="RegularSubject" Grid.Column="1" Header="科目"/><ComboBox x:Name="RegularTeacher" Grid.Column="2" Header="通常担当講師（任意）"/><NumberBox x:Name="RegularPriority" Grid.Column="3" Header="優先度 1～5" Minimum="1" Maximum="5" Value="3"/><Button Grid.Column="4" VerticalAlignment="Bottom" Content="保存" Click="SaveRegularLesson_Click"/></Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="RegularOneToOne" Content="1対1必須"/><TextBox x:Name="RegularNote" Width="420" Header="備考"/></StackPanel>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/><ColumnDefinition Width="160"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="生徒氏名"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="科目"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="通常担当講師"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="優先度"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="1対1"/></Grid>
                <ListView x:Name="RegularLessons">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/><ColumnDefinition Width="160"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StudentName}"/><TextBlock Grid.Column="1" Text="{Binding SubjectName}"/><TextBlock Grid.Column="2" Text="{Binding TeacherName}"/><TextBlock Grid.Column="3" Text="{Binding Priority}"/><TextBlock Grid.Column="4" Text="{Binding OneToOneText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel></TabViewItem>
            <TabViewItem Header="コマ・開校日"><StackPanel Padding="16" Spacing="12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="コマ設定"/>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SlotCode" Header="コード"/><TextBox x:Name="SlotName" Grid.Column="1" Header="表示名"/>
                    <ComboBox x:Name="SlotStartTime" Grid.Column="2" Header="開始" IsEditable="True" PlaceholderText="09:00"/>
                    <ComboBox x:Name="SlotEndTime" Grid.Column="3" Header="終了" IsEditable="True" PlaceholderText="10:00"/>
                    <NumberBox x:Name="SlotOrder" Grid.Column="4" Header="順序" Minimum="1" Value="1"/><Button Grid.Column="5" VerticalAlignment="Bottom" Content="保存" Click="AddSlot_Click"/>
                </Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="SlotActive" Content="有効" IsChecked="True" Checked="SlotActive_Changed" Unchecked="SlotActive_Changed"/><Button Content="新規入力" Click="NewSlot_Click"/></StackPanel>
                <TextBlock Text="▲▼で表示順を並べ替えられます（動かすとすぐに保存されます）。右端の×で削除できます（時間割配置等で使用中のコマは削除できません）。" TextWrapping="Wrap"/>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="コード"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="表示名"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="開始"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="終了"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="状態"/>
                </Grid>
                <ListView x:Name="TimeSlots" SelectionChanged="TimeSlots_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.Code}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value.DisplayName}"/>
                                <TextBlock Grid.Column="2" Text="{Binding StartText}"/>
                                <TextBlock Grid.Column="3" Text="{Binding EndText}"/>
                                <TextBlock Grid.Column="4" Text="{Binding StatusText}"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                    <Button Content="▲" Padding="8,2" Tag="{Binding Value.Id}" Click="MoveSlotUp_Click"/>
                                    <Button Content="▼" Padding="8,2" Tag="{Binding Value.Id}" Click="MoveSlotDown_Click"/>
                                    <Button Content="×" Padding="10,2" Tag="{Binding Value.Id}" Click="DeleteSlot_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Margin="0,12,0,0" FontSize="18" FontWeight="SemiBold" Text="開校日・休校日カレンダー"/>
                <TextBlock x:Name="CourseDayPeriodLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="日付をクリックまたはチェックで選び、下の一括操作かコマのチェックで反映します。変更はすぐに保存されます。" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="休校日を全て選択" Click="CalendarSelectClosedDays_Click"/>
                    <Button Content="開校日を全て選択" Click="CalendarSelectOpenDays_Click"/>
                    <ComboBox x:Name="CalendarWeekday" Width="110" SelectedIndex="0"><ComboBoxItem Content="日曜日"/><ComboBoxItem Content="月曜日"/><ComboBoxItem Content="火曜日"/><ComboBoxItem Content="水曜日"/><ComboBoxItem Content="木曜日"/><ComboBoxItem Content="金曜日"/><ComboBoxItem Content="土曜日"/></ComboBox>
                    <Button Content="○曜日を選択" Click="CalendarSelectWeekday_Click"/>
                    <Button Content="すべて選択" Click="CalendarSelectAll_Click"/>
                    <Button Content="選択解除" Click="CalendarClearSelection_Click"/>
                    <TextBlock x:Name="CalendarSelectionCount" VerticalAlignment="Center" Text="0件選択中"/>
                    <Button Content="選択日を休校" Click="CalendarCloseSelected_Click" Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="選択日を開校" Click="CalendarOpenSelected_Click" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
                <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="選択日に使用するコマ"/>
                        <StackPanel x:Name="CalendarSlotTogglePanel" Orientation="Horizontal" Spacing="8"/>
                        <Button Content="全コマ" Click="CalendarAllSlots_Click"/>
                    </StackPanel>
                </Border>
                <Grid x:Name="CalendarWeekdayHeader" ColumnSpacing="2"/>
                <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="CourseDayCalendar" ColumnSpacing="2" RowSpacing="2"/>
                </ScrollViewer>
            </StackPanel></TabViewItem>
            <TabViewItem Header="スケジュール設定">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="⑦最適化探索の方針設定"/>
                    <TextBlock Text="ここで保存した内容がこのプロジェクトの既定値になります。⑤時間割自動作成の画面でも、その回だけの一時的な変更ができます。" TextWrapping="Wrap"/>
                    <NumberBox x:Name="PolicyMaxStudentsPerTeacher" Minimum="1" Maximum="10" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="420">
                        <NumberBox.Header>
                            <TextBlock Text="一人の講師が同時に担当できる生徒数（既定は2人）" TextWrapping="NoWrap"/>
                        </NumberBox.Header>
                    </NumberBox>

                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="①一日当たりの講師人数"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyTeacherCountPerDayNone" Content="考慮しない" GroupName="PolicyTeacherCountPerDay" IsChecked="True"/>
                        <RadioButton x:Name="PolicyTeacherCountPerDayMinimize" Content="できるだけ少なくする" GroupName="PolicyTeacherCountPerDay"/>
                        <RadioButton x:Name="PolicyTeacherCountPerDayMaximize" Content="できるだけ多くする" GroupName="PolicyTeacherCountPerDay"/>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="②講師ごとのコマ数の偏り"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyTeacherLoadBalanceNone" Content="考慮しない" GroupName="PolicyTeacherLoadBalance" IsChecked="True"/>
                        <RadioButton x:Name="PolicyTeacherLoadBalanceBalance" Content="均等にする" GroupName="PolicyTeacherLoadBalance"/>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="③生徒の授業日"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyStudentAttendanceDaysNone" Content="考慮しない" GroupName="PolicyStudentAttendanceDays" IsChecked="True"/>
                        <RadioButton x:Name="PolicyStudentAttendanceDaysConcentrate" Content="できるだけ減らす（同じ日にまとめる）" GroupName="PolicyStudentAttendanceDays"/>
                        <RadioButton x:Name="PolicyStudentAttendanceDaysSpread" Content="分散する" GroupName="PolicyStudentAttendanceDays"/>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="④講師の出勤日"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyTeacherAttendanceDaysNone" Content="考慮しない" GroupName="PolicyTeacherAttendanceDays" IsChecked="True"/>
                        <RadioButton x:Name="PolicyTeacherAttendanceDaysConcentrate" Content="できるだけ減らす（同じ日にまとめる）" GroupName="PolicyTeacherAttendanceDays"/>
                        <RadioButton x:Name="PolicyTeacherAttendanceDaysSpread" Content="分散する" GroupName="PolicyTeacherAttendanceDays"/>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="⑤1コマあたりの生徒の対応人数"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyPairingSizeNone" Content="考慮しない" GroupName="PolicyPairingSize" IsChecked="True"/>
                        <RadioButton x:Name="PolicyPairingSizeMaximize" Content="できるだけ多くする" GroupName="PolicyPairingSize"/>
                        <RadioButton x:Name="PolicyPairingSizeMinimize" Content="できるだけ少なくする" GroupName="PolicyPairingSize"/>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="⑥時間帯"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyTimeOfDayNone" Content="考慮しない" GroupName="PolicyTimeOfDay" IsChecked="True"/>
                        <RadioButton x:Name="PolicyTimeOfDayLate" Content="できるだけ遅くする" GroupName="PolicyTimeOfDay"/>
                        <RadioButton x:Name="PolicyTimeOfDayEarly" Content="できるだけ早くする" GroupName="PolicyTimeOfDay"/>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="⑦同一講師×同一生徒の連続コマ"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyTeacherStudentConsecutiveNone" Content="考慮しない" GroupName="PolicyTeacherStudentConsecutive" IsChecked="True"/>
                        <RadioButton x:Name="PolicyTeacherStudentConsecutivePreferConsecutive" Content="できるだけ連続にする" GroupName="PolicyTeacherStudentConsecutive"/>
                    </StackPanel>

                    <NumberBox x:Name="PolicyMaxConcurrentSeats" Header="⑧同時に使える座席数（0=考慮しない）" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="280"/>

                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="既定の時間（名目時間の2倍）になっても未配置が残っている場合"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="PolicyContinueBeyondNominalTimeYes" Content="そのまま完成するまで（または中断するまで）継続する" GroupName="PolicyContinueBeyondNominalTime" IsChecked="True"/>
                        <RadioButton x:Name="PolicyContinueBeyondNominalTimeNo" Content="そこで打ち切る（従来通り）" GroupName="PolicyContinueBeyondNominalTime"/>
                    </StackPanel>

                    <Button Content="保存" Click="SaveSchedulingPolicy_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabViewItem>
            <TabViewItem Header="科目"><StackPanel Padding="16" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SubjectCode" Header="コード"/><TextBox x:Name="SubjectName" Grid.Column="1" Header="科目名"/><TextBox x:Name="SubjectShort" Grid.Column="2" Header="略称" PlaceholderText="1文字（空欄で自動推定）" MaxLength="1"/><ComboBox x:Name="SubjectLevel" Grid.Column="3" Header="校種" IsEditable="True" PlaceholderText="校種を選択または入力"><ComboBoxItem Content="小学校"/><ComboBoxItem Content="中学校"/><ComboBoxItem Content="高等学校"/></ComboBox><NumberBox x:Name="SubjectOrder" Grid.Column="4" Header="順序" Minimum="1" Value="1"/><Button Grid.Column="5" VerticalAlignment="Bottom" Content="保存" Click="AddSubject_Click"/></Grid><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox x:Name="SubjectActive" Content="有効" IsChecked="True" Checked="SubjectActive_Changed" Unchecked="SubjectActive_Changed"/><Button Content="新規入力" Click="NewSubject_Click"/></StackPanel><TextBox x:Name="SubjectSearch" PlaceholderText="コード・科目名・校種で検索" TextChanged="SubjectSearch_TextChanged"/>
                <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="順序"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="コード"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="科目名"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="略称"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="校種"/><TextBlock Grid.Column="5" FontWeight="SemiBold" Text="状態"/></Grid>
                <ListView x:Name="Subjects" SelectionChanged="Subjects_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.SortOrder}"/><TextBlock Grid.Column="1" Text="{Binding Value.Code}"/><TextBlock Grid.Column="2" Text="{Binding Value.DisplayName}"/><TextBlock Grid.Column="3" Text="{Binding Value.ShortName}"/><TextBlock Grid.Column="4" Text="{Binding Value.SchoolLevel}"/><TextBlock Grid.Column="5" Text="{Binding StatusText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel></TabViewItem>
            <TabViewItem Header="出力設定">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="⑥出力の書式設定"/>
                    <TextBlock Text="PDFの用紙サイズ・向き・余白、出力ファイル名の規則（{project}=プロジェクト名、{report}=帳票名、{date}=出力日）、主な塗り色を設定します。" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <ComboBox x:Name="OutputPaperSize" Header="用紙サイズ" Grid.Row="0" Grid.Column="0"><ComboBoxItem Content="A4"/><ComboBoxItem Content="A3"/></ComboBox>
                        <ComboBox x:Name="OutputOrientation" Header="向き" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="横（landscape）" Tag="landscape"/><ComboBoxItem Content="縦（portrait）" Tag="portrait"/></ComboBox>
                        <NumberBox x:Name="OutputMarginMm" Header="余白（mm）" Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="30" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                    <TextBox x:Name="OutputFileNamePattern" Header="ファイル名規則" PlaceholderText="{}{project}-{report}"/>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="塗り色（#RRGGBB形式）"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="200"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputClosedColor" Header="休校日" Grid.Column="0"/>
                        <TextBox x:Name="OutputUnavailableColor" Header="勤務不可コマ" Grid.Column="1"/>
