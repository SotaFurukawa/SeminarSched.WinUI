<local:WorkflowPageBase
    x:Class="SeminarSched_WinUI.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeminarSched_WinUI.Pages"
    Loaded="Page_Loaded">
    <ScrollViewer><StackPanel MaxWidth="960" Padding="24" HorizontalAlignment="Left" Spacing="16">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="① 設定"/>
        <InfoBar x:Name="ProjectRequired"/>
        <InfoBar x:Name="Status" IsClosable="True"/>
        <TextBlock Text="プロジェクト、開校日、コマ、科目、生徒・講師の共通基本情報を設定します。" TextWrapping="Wrap"/>
        <TabView x:Name="Tabs">
            <TabViewItem Header="プロジェクト"><StackPanel Padding="16" Spacing="8"><TextBlock x:Name="ProjectTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ProjectPeriod"/><TextBlock Text="新規作成・読込み・バックアップ・復元はホームから操作できます。" TextWrapping="Wrap"/></StackPanel></TabViewItem>
            <TabViewItem Header="生徒"><StackPanel Padding="16" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StudentId" Header="生徒ID"/><TextBox x:Name="StudentName" Grid.Column="1" Header="氏名"/><TextBox x:Name="StudentGrade" Grid.Column="2" Header="学年"/><Button Grid.Column="3" VerticalAlignment="Bottom" Content="追加" Click="AddStudent_Click"/></Grid><ListView x:Name="Students"/></StackPanel></TabViewItem>
            <TabViewItem Header="講師"><StackPanel Padding="16" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TeacherId" Header="講師ID"/><TextBox x:Name="TeacherName" Grid.Column="1" Header="氏名"/><Button Grid.Column="2" VerticalAlignment="Bottom" Content="追加" Click="AddTeacher_Click"/></Grid><ListView x:Name="Teachers"/></StackPanel></TabViewItem>
            <TabViewItem Header="科目"><StackPanel Padding="16" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SubjectCode" Header="コード"/><TextBox x:Name="SubjectName" Grid.Column="1" Header="科目名"/><TextBox x:Name="SubjectShort" Grid.Column="2" Header="略称"/><TextBox x:Name="SubjectLevel" Grid.Column="3" Header="校種"/><NumberBox x:Name="SubjectOrder" Grid.Column="4" Header="順序" Minimum="1" Value="1"/><Button Grid.Column="5" VerticalAlignment="Bottom" Content="追加" Click="AddSubject_Click"/></Grid><ListView x:Name="Subjects"/></StackPanel></TabViewItem>
            <TabViewItem Header="コマ・開校日"><StackPanel Padding="16" Spacing="12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="コマ設定"/>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SlotCode" Header="コード"/><TextBox x:Name="SlotName" Grid.Column="1" Header="表示名"/><TimePicker x:Name="SlotStart" Grid.Column="2" Header="開始" ClockIdentifier="24HourClock"/><TimePicker x:Name="SlotEnd" Grid.Column="3" Header="終了" ClockIdentifier="24HourClock"/><NumberBox x:Name="SlotOrder" Grid.Column="4" Header="順序" Minimum="1" Value="1"/><Button Grid.Column="5" VerticalAlignment="Bottom" Content="追加" Click="AddSlot_Click"/>
                </Grid><ListView x:Name="TimeSlots"/>
                <TextBlock Margin="0,12,0,0" FontSize="18" FontWeight="SemiBold" Text="開校日・休校日"/>
                <TextBlock Text="日付を選び、開校または休校へ切り替えます。「開校」は現在有効な全コマをその日に設定します。" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="開校（全コマ）" Click="SetOpenDay_Click"/><Button Content="休校" Click="SetClosedDay_Click"/></StackPanel>
                <ListView x:Name="CourseDays" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Width="120" Text="{Binding Date}"/><TextBlock Width="60" Text="{Binding StatusLabel}"/><TextBlock Text="{Binding SlotSummary}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
            </StackPanel></TabViewItem>
        </TabView>
    </StackPanel></ScrollViewer>
</local:WorkflowPageBase>
