<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SeminarSched_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SeminarSched_WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="設定" />
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="現在このアプリに個別の設定項目はありません。バージョン情報は「アプリ情報」をご覧ください。" TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="ライセンス" />
            <TextBlock x:Name="LicenseStatusTextBlock" TextWrapping="Wrap" />

            <!-- ユーザー指摘（checkpoint128）「アップデートの確認とその表題の『アップデート』が
                 離れすぎている。左上⇨アップデート、右上⇨アップデートを確認ボタン、左下⇨最新
                 バージョン（バージョン番号）です」への対応。見出しとボタンを同じ行に、状態文言を
                 見出しの直下に配置する。 -->
            <Grid Margin="0,16,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" FontWeight="SemiBold" Text="アップデート" VerticalAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="1" x:Name="CheckUpdateButton" Content="アップデートを確認" Click="CheckUpdate_Click" />
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="UpdateStatusTextBlock" MaxWidth="500" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="OpenReleaseButton" Content="ダウンロードページを開く" Click="OpenRelease_Click" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
