<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SeminarSched_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SeminarSched_WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="設定" />
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="現在このアプリに個別の設定項目はありません。バージョン情報は「アプリ情報」をご覧ください。" TextWrapping="Wrap" />

            <!-- ユーザー指摘（checkpoint129）「アップデートを確認、が左側の文字列から少し遠い。近くに
                 持ってきてほしい」への対応。列をAuto/Autoにして、見出し・ボタンが自身の実測幅ぶんだけで
                 並ぶようにし、ウィンドウ右端まで引き離されないようにした（ライセンス欄も同じ構成に揃えた）。
                 また「これは動作確認のためでもあるが、ライセンスの解除ができるようにしてほしい。
                 アップデートを確認の上あたりに」への対応で、ライセンス欄にも見出しと同じ行へ
                 「ライセンスを解除」ボタンを追加した。 -->
            <!-- ユーザー要望（checkpoint155）「ライセンスを解除のボタンとアップデートを確認のボタンの
                 左端と右端をそろえてほしい」への対応。以前は「ライセンス」「アップデート」それぞれが
                 独立したGridで、ボタン列(column1)の幅がGridごとに自身の見出し文字幅だけで決まって
                 いたため、見出しの文字数が違う分だけボタンの開始位置がずれていた。1つのGridへ統合し、
                 column1の幅をライセンス・アップデート両方のボタンのうち最大の幅に揃える（Auto列は
                 同じGrid内の全行の最大幅で決まるため、自動的に左端・右端とも一致する）。 -->
            <!-- ユーザー要望「ボタンの左端をそろえるように。今のところから5cm程度ボタンが右にずれる
                 ようにして、左端をそろえる」への対応。column0（見出し列）をAuto（見出し文字幅だけ）
                 から固定幅へ変更し、見出しとボタンの間に意図的な余白を作ることで、ボタン列全体を
                 右へ押し出した（5cm≈189epx相当を目安に、元のAuto幅(約110px)へ加算した300pxとした）。
                 column1自体は変わらずAutoのままのため、左端・右端の揃いは維持される。 -->
            <!-- ユーザー指摘「アップデートを行うのボタンがずれてしまう。ボタンはそろえてほしい。
                 できれば、横の長さをすべて同じにして、ボタンの横が合うようにしてほしい」への対応。
                 以前は「アップデートを行う」ボタンだけ、状態文言（UpdateStatusTextBlock）と同じ
                 横並びのStackPanel内にあったため、状態文言の長さぶんだけボタンの開始位置が
                 ずれ、幅も他の2つのボタンと揃っていなかった。他の2つのボタンと同じ
                 Grid.Column="1"へ移し、状態文言はGrid.Column="0"へ収めることで、3つのボタンが
                 同じAuto列幅（ButtonのHorizontalAlignment既定値Stretchにより、列内の最大幅へ
                 自動的に揃う）を共有し、左端・右端とも一致するようにした。 -->
            <Grid Margin="0,16,0,0" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" FontWeight="SemiBold" Text="ライセンス" VerticalAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="1" x:Name="ReleaseLicenseButton" Content="ライセンスを解除" Click="ReleaseLicense_Click" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LicenseStatusTextBlock" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="アップデート" VerticalAlignment="Center" />
                <Button Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" x:Name="CheckUpdateButton" Content="アップデートを確認" Click="CheckUpdate_Click" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="3" Grid.Column="0" x:Name="UpdateStatusTextBlock" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Row="3" Grid.Column="1" x:Name="PerformUpdateButton" Content="アップデートを行う" Click="PerformUpdate_Click" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                <!-- ユーザー要望「インストール時にデフォルトの保存先を指定しておき、workspaceを
                     置く場所を変更できるようにする」への対応。既定の保存先（%LOCALAPPDATA%\
                     SeminarSched.WinUI）は変えず、設定ページから別のフォルダーへ移動できるように
                     する（WorkspaceRootResolver参照）。移動の実際のコピーは、ファイルが使用中に
                     ならない次回起動時に行うため、ここでは要求して案内するだけ。 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="データの保存先" VerticalAlignment="Center" />
                <Button Grid.Row="4" Grid.Column="1" Margin="0,16,0,0" x:Name="ChangeWorkspaceLocationButton" Content="保存先を変更する" Click="ChangeWorkspaceLocation_Click" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="WorkspaceLocationTextBlock" TextWrapping="Wrap" />
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="WorkspaceLocationStatusTextBlock" TextWrapping="Wrap" />
                <!-- ユーザー要望「こういう不具合が発生したときのためにアンインストールボタンを
                     追加したい。設定のアップデートの下にアンインストールを追加してください」への
                     対応。既存のInno Setupインストーラーが登録した標準のアンインストーラー
                     （unins000.exe）をそのまま起動する（WindowsAppUninstaller参照）。プロジェクト
                     ファイルや共通名簿等のユーザーデータは、インストーラー側の設計により
                     アンインストールしても削除されない。 -->
                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="アンインストール" VerticalAlignment="Center" />
                <Button Grid.Row="7" Grid.Column="1" Margin="0,16,0,0" x:Name="UninstallButton" Content="アンインストールする" Click="Uninstall_Click" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" x:Name="UninstallStatusTextBlock" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
