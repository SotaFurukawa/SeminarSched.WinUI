<local:WorkflowPageBase x:Class="SeminarSched_WinUI.Pages.ImportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SeminarSched_WinUI.Pages" NavigationCacheMode="Required" Loaded="Page_Loaded"><ScrollViewer><StackPanel MaxWidth="1400" Padding="24" Spacing="16" HorizontalAlignment="Left"><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="3 アンケート取込"/><InfoBar x:Name="ProjectRequired"/><InfoBar x:Name="Status" IsClosable="True"/>
<Border Padding="24" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8"><Image Width="22" Height="22" VerticalAlignment="Center"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/GoogleFormsIcon.svg"/></Image.Source></Image><TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Googleフォーム回答の取込"/></StackPanel>
        <TextBlock Text="Googleフォームからダウンロードしたアンケート回答を検証し、受講希望や出席出勤可能日をそのまま反映します。時間割配置後にアンケートを取り込み直す場合には、時間割のリセットを行ってください。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SurveySelectStudentButton" Content="1 生徒のアンケート回答ファイルを選ぶ" Click="SurveySelectStudent_Click" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="SurveySelectTeacherButton" Content="2 講師のアンケート回答ファイルを選ぶ" Click="SurveySelectTeacher_Click" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="SurveyVerifyButton" Content="3 検証する" IsEnabled="False" Click="SurveyVerify_Click"/><Button x:Name="SurveyApplyButton" Content="4 反映する" IsEnabled="False" Click="SurveyApply_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
        <TextBlock x:Name="SurveySelectedFilesText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="SurveySummary" TextWrapping="Wrap" Visibility="Collapsed"/>
        <ListView x:Name="SurveyIssues" MaxHeight="240"/>
    </StackPanel>
</Border>
<Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="受講希望"/>
        <TextBlock Text="必要な授業回数や希望の担当講師などを、生徒ごとに編集できます。マッチング優先度はホームの基本情報に対応しています。今回の講習限定で変更したい場合や、アンケート回答とは別で追加・修正したい場合は、一覧から編集できます。" TextWrapping="Wrap"/>
        <!-- ユーザー要望（checkpoint142）「アンケート取込後の一覧についても、設定の生徒、講師、科目と
             同様に追加できるようにする」への対応。常時表示の入力フォームを廃止し、SetupPageの
             生徒・講師・科目タブと同じ行内編集方式（追加ボタン→末尾に編集行、既存行はホバーで
             「変更」）へ変更した。LessonRequestは外部キーが多く1行に収まらないため、編集パネルは
             旧フォームと同じ複数行レイアウトのまま、一覧の行の位置に展開される形にした
             （ImportPageRowViewModels.cs参照）。 -->
        <StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="LessonRequestSearch" PlaceholderText="生徒名・科目名で検索" TextChanged="LessonRequestSearch_TextChanged" Width="320"/><Button Content="受講希望を追加" Click="AddLessonRequestRow_Click"/></StackPanel>
        <!-- ユーザー要望（checkpoint142）の列追加により1行あたりの項目数が増え、ウィンドウ幅が
             狭い場合は末尾の変更/削除ボタンまで収まらないことがあるため、見出し・一覧をまとめて
             横スクロール可能にした（講師指導可能科目タブの表と同じ「幅が足りなければ横スクロール」
             という考え方）。 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" MinWidth="1020">
        <!-- ユーザー報告（checkpoint150）「氏名と学年がくっついて表示されているように見えます。
             別の列にしてください」への対応。生徒氏名セルに全角スペース区切りで学年を連結していたのを
             やめ、学年専用の列を生徒氏名の右に追加した。また「隙間が大きい・ずれている」という
             指摘についても調査し、見出し・データ行の列定義自体は完全に一致している（列幅のズレでは
             ない）ことを実機で確認した。実際の原因は、数字や短い単語（必要回数・優先度・1対1・
             最大連続コマ数・空きコマ許可・学年）の列が見出しの折り返し防止のため広めの固定幅を
             持つ一方、値は既定の左寄せのまま描画されるため、値が列の左端に寄って右側に大きな余白が
             でき、隣の列と繋がって見えていたことによる。これらの列は見出し・データとも中央寄せに
             変更し、値が列の中央（＝見出しの真下）に来るようにした。生徒氏名・科目名・通常担当
             講師・第1〜3希望（氏名系で長さが揺れる列）は従来通り左寄せのまま維持する。 -->
        <!-- ユーザー報告（checkpoint153）「まだ隙間が大きすぎる。特に学年と生徒氏名の幅が大きい。
             そのせいでカーソルを合わせたときに右に出てくる変更と削除により、左側に押されてしまい、
             列がずれてしまう」への対応。生徒氏名・科目名の列だけがWidth="*"（残り幅を全て消費）に
             なっていたため、ウィンドウが広いときにこの2列だけが実際の文字列よりはるかに広く伸び、
             見た目上の余白になっていた。さらに、ホバー時だけ現れる末尾の変更/削除ボタン列
             （下のデータ行側だけにあるAuto列。見出し側には存在しない）の有無で、Grid全体の残り幅が
             増減するため、"*"列の実際の幅がホバーのたびに変化し、見出しとデータの列位置がずれて
             見えていた。生徒氏名・科目名を固定幅（SetupPageの生徒・講師一覧と同じ、"*"を一切使わない
             方式）に変更し、ホバー列の有無に関わらず他の列の幅が変わらないようにした。 -->
        <Grid ColumnSpacing="6" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="55"/><ColumnDefinition Width="110"/><ColumnDefinition Width="55"/><ColumnDefinition Width="90"/><ColumnDefinition Width="45"/><ColumnDefinition Width="35"/><ColumnDefinition Width="105"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold" Text="生徒氏名"/>
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="学年" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="科目名"/>
            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="必要回数" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="通常担当講師"/>
            <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="優先度" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="1対1" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="最大連続コマ数" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Grid.Column="8" FontWeight="SemiBold" Text="第1希望"/>
            <TextBlock Grid.Column="9" FontWeight="SemiBold" Text="第2希望"/>
            <TextBlock Grid.Column="10" FontWeight="SemiBold" Text="第3希望"/>
            <TextBlock Grid.Column="11" FontWeight="SemiBold" Text="空きコマ許可" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
        </Grid>
        <ListView x:Name="LessonRequests" SelectionMode="None" MaxHeight="520">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LessonRequestRowViewModel">
                    <Grid Padding="4">
                        <Grid ColumnSpacing="6" Background="Transparent" Visibility="{x:Bind DisplayVisibility, Mode=OneWay}" PointerEntered="LessonRequestRow_PointerEntered" PointerExited="LessonRequestRow_PointerExited">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="55"/><ColumnDefinition Width="110"/><ColumnDefinition Width="55"/><ColumnDefinition Width="90"/><ColumnDefinition Width="45"/><ColumnDefinition Width="35"/><ColumnDefinition Width="105"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="92"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind StudentName, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Grade, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind SubjectName, Mode=OneWay}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Value.RequiredSessions, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind RegularTeacherName, Mode=OneWay}"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind Value.RegularTeacherPriority, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind OneToOneText, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{x:Bind MaxConsecutiveText, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="{x:Bind Preferred1Name, Mode=OneWay}"/>
                            <TextBlock Grid.Column="9" Text="{x:Bind Preferred2Name, Mode=OneWay}"/>
                            <TextBlock Grid.Column="10" Text="{x:Bind Preferred3Name, Mode=OneWay}"/>
                            <TextBlock Grid.Column="11" Text="{x:Bind AllowGapText, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <StackPanel x:Name="ChangeDeletePanel" Grid.Column="12" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                <Button Content="変更" Click="LessonRequestRow_Change_Click"/>
                                <Button Content="削除" Click="LessonRequestRow_Delete_Click"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="10" Visibility="{x:Bind EditVisibility, Mode=OneWay}" Padding="0,8,0,8">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="LessonRequestStudentBox" Header="生徒" Width="180" ItemsSource="{x:Bind StudentOptions}" SelectedItem="{x:Bind DraftStudent, Mode=TwoWay}" Loaded="LessonRequestStudentBox_Loaded"/>
                                <ComboBox Grid.Column="1" Header="科目" Width="140" ItemsSource="{x:Bind SubjectOptions}" SelectedItem="{x:Bind DraftSubject, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="2" Header="必要授業回数" Minimum="1" Width="140" Value="{x:Bind DraftRequiredSessions, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Header="通常担当講師（任意）" Width="200" ItemsSource="{x:Bind TeacherOptions}" SelectedItem="{x:Bind DraftRegularTeacher, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="1" Header="優先度 1～5" Minimum="1" Maximum="5" Width="100" Value="{x:Bind DraftRegularPriority, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Header="第1希望講師（任意）" Width="220" ItemsSource="{x:Bind TeacherOptions}" SelectedItem="{x:Bind DraftPreferred1, Mode=TwoWay}"/>
                                <ComboBox Grid.Column="1" Header="第2希望講師（任意）" Width="220" ItemsSource="{x:Bind TeacherOptions}" SelectedItem="{x:Bind DraftPreferred2, Mode=TwoWay}"/>
                                <ComboBox Grid.Column="2" Header="第3希望講師（任意）" Width="220" ItemsSource="{x:Bind TeacherOptions}" SelectedItem="{x:Bind DraftPreferred3, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                <ComboBox Header="1対1必須" SelectedIndex="{x:Bind DraftOneToOneIndex, Mode=TwoWay}"><ComboBoxItem Content="いいえ"/><ComboBoxItem Content="はい"/></ComboBox>
                                <NumberBox Grid.Column="1" Header="最大連続コマ数（0=既定値）" Minimum="0" Value="{x:Bind DraftMaxConsecutiveOverride, Mode=TwoWay}"/>
                                <ComboBox Grid.Column="2" Header="空きコマ許可" SelectedIndex="{x:Bind DraftAllowGapOverrideIndex, Mode=TwoWay}"><ComboBoxItem Content="指定なし"/><ComboBoxItem Content="許可"/><ComboBoxItem Content="不許可"/></ComboBox>
                            </Grid>
                            <TextBox Header="備考" Text="{x:Bind DraftNote, Mode=TwoWay}"/>
                            <Button Content="保存" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveLessonRequestRow_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </StackPanel>
        </ScrollViewer>
    </StackPanel>
</Border>
<Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="可用性の手動編集"/>
        <TextBlock Text="生徒または講師を1名選び、カレンダーで日ごとの参加可否をそのまま編集できます。チェックを入れると参加可能（緑）、外すと参加不可（赤）になり、保存操作なしですぐに反映されます。取込済みの回答も上書きされます。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton x:Name="MatrixStudentKind" Content="生徒" IsChecked="True" Checked="MatrixKind_Changed"/>
            <RadioButton x:Name="MatrixTeacherKind" Content="講師" Checked="MatrixKind_Changed"/>
        </StackPanel>
        <ComboBox x:Name="MatrixEntity" Header="対象" DisplayMemberPath="Label" SelectionChanged="MatrixEntity_SelectionChanged" MinWidth="280" HorizontalAlignment="Left"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4">
                <Grid x:Name="AvailabilityCalendarWeekdayHeader"/>
                <Grid x:Name="AvailabilityCalendarGrid" ColumnSpacing="4" RowSpacing="4"/>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</Border>
</StackPanel></ScrollViewer></local:WorkflowPageBase>
