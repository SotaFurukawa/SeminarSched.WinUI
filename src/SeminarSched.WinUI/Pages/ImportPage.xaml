<local:WorkflowPageBase x:Class="SeminarSched_WinUI.Pages.ImportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SeminarSched_WinUI.Pages" Loaded="Page_Loaded"><ScrollViewer><StackPanel Padding="24" Spacing="16"><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="③ アンケート取込み"/><InfoBar x:Name="ProjectRequired"/><InfoBar x:Name="Status" IsClosable="True"/>
<Border Padding="24" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="🟦 Googleフォーム回答の取込み（通常はこちらを使う）"/>
        <TextBlock Text="Googleフォームからそのままダウンロードした生徒・講師の回答CSV/XLSX（質問文そのままの列名）を検証し、生徒・講師ごとに受講希望・可用性を全置換で反映します。時間割配置後は使用できません。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SurveySelectStudentButton" Content="① 生徒フォームの回答ファイルを選ぶ" Click="SurveySelectStudent_Click" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="SurveySelectTeacherButton" Content="② 講師フォームの回答ファイルを選ぶ" Click="SurveySelectTeacher_Click" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="SurveyVerifyButton" Content="③ 検証する" IsEnabled="False" Click="SurveyVerify_Click"/><Button x:Name="SurveyApplyButton" Content="④ 反映する" IsEnabled="False" Click="SurveyApply_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
        <TextBlock x:Name="SurveySelectedFilesText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="SurveySummary" TextWrapping="Wrap" Visibility="Collapsed"/>
        <ListView x:Name="SurveyIssues" MaxHeight="240"/>
    </StackPanel>
</Border>
<Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="受講希望"/>
        <TextBlock Text="生徒ごとの受講希望（必要授業回数・希望講師）を個別に登録・編集します。通常はアンケート取込みで自動反映されますが、ここで個別に追加・修正できます。一覧から選ぶと編集できます。" TextWrapping="Wrap"/>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="RequestStudent" Header="生徒"/><ComboBox x:Name="RequestSubject" Grid.Column="1" Header="科目"/><NumberBox x:Name="RequestRequiredSessions" Grid.Column="2" Header="必要授業回数" Minimum="1" Value="1"/><ComboBox x:Name="RequestRegularTeacher" Grid.Column="3" Header="通常担当講師（任意）"/><NumberBox x:Name="RequestRegularPriority" Grid.Column="4" Header="優先度 1～5" Minimum="1" Maximum="5" Value="3"/>
        </Grid>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="RequestPreferred1" Header="第1希望講師（任意）"/><ComboBox x:Name="RequestPreferred2" Grid.Column="1" Header="第2希望講師（任意）"/><ComboBox x:Name="RequestPreferred3" Grid.Column="2" Header="第3希望講師（任意）"/>
        </Grid>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="RequestOneToOne" Content="1対1必須" VerticalAlignment="Bottom"/><NumberBox x:Name="RequestMaxConsecutiveOverride" Grid.Column="1" Header="最大連続コマ数上書き（0=既定値）" Minimum="0" Value="0"/><ComboBox x:Name="RequestAllowGapOverride" Grid.Column="2" Header="空きコマ許可上書き" SelectedIndex="0"><ComboBoxItem Content="指定なし"/><ComboBoxItem Content="許可"/><ComboBoxItem Content="不許可"/></ComboBox>
        </Grid>
        <TextBox x:Name="RequestNote" Header="備考"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存" Click="SaveLessonRequest_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="新規入力" Click="NewLessonRequest_Click"/><Button Content="選択した行を削除" Click="DeleteLessonRequest_Click"/></StackPanel>
        <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="70"/><ColumnDefinition Width="160"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold" Text="生徒氏名"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="科目名"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="必要回数"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="通常担当講師"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="優先度"/><TextBlock Grid.Column="5" FontWeight="SemiBold" Text="1対1"/>
        </Grid>
        <ListView x:Name="LessonRequests" SelectionChanged="LessonRequests_SelectionChanged" MaxHeight="360">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="70"/><ColumnDefinition Width="160"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StudentName}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SubjectName}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value.RequiredSessions}"/>
                        <TextBlock Grid.Column="3" Text="{Binding RegularTeacherName}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Value.RegularTeacherPriority}"/>
                        <TextBlock Grid.Column="5" Text="{Binding OneToOneText}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Border>
<Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="可用性の手動編集"/>
        <TextBlock Text="複数の生徒または講師を選び、特定の日付・コマへ参加可否（0:不可 / 1:可 / 2:優先）を一括で設定できます。取込済みの回答も上書きされます。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton x:Name="MatrixStudentKind" Content="生徒" IsChecked="True" Checked="MatrixKind_Changed"/>
            <RadioButton x:Name="MatrixTeacherKind" Content="講師" Checked="MatrixKind_Changed"/>
        </StackPanel>
        <ListView x:Name="MatrixEntities" SelectionMode="Multiple" MaxHeight="180" DisplayMemberPath="Label" SelectionChanged="MatrixEntities_SelectionChanged"/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="MatrixDate" Header="日付" DisplayMemberPath="Label" SelectionChanged="MatrixDate_SelectionChanged"/>
            <ComboBox x:Name="MatrixSlot" Grid.Column="1" Header="コマ" DisplayMemberPath="Label"/>
            <ComboBox x:Name="MatrixLevel" Grid.Column="2" Header="値" SelectedIndex="1">
                <ComboBoxItem Content="0: 不可"/>
                <ComboBoxItem Content="1: 可"/>
                <ComboBoxItem Content="2: 優先"/>
            </ComboBox>
            <Button Grid.Column="3" VerticalAlignment="Bottom" Content="選択した対象へ一括適用" Click="ApplyMatrix_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
        <TextBlock Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold" Text="複数日付・複数コマへ一括適用"/>
        <TextBlock Text="上で選択した対象（生徒/講師）へ、複数の日付と複数のコマのすべての組み合わせに同じ値をまとめて適用します。" TextWrapping="Wrap"/>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock Text="日付"/><ListView x:Name="BulkMatrixDates" SelectionMode="Multiple" MaxHeight="160" DisplayMemberPath="Label"/></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="コマ"/><ListView x:Name="BulkMatrixSlots" SelectionMode="Multiple" MaxHeight="160" DisplayMemberPath="Label"/></StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <ComboBox x:Name="BulkMatrixLevel" Header="値" SelectedIndex="1">
                <ComboBoxItem Content="0: 不可"/>
                <ComboBoxItem Content="1: 可"/>
                <ComboBoxItem Content="2: 優先"/>
            </ComboBox>
            <Button Content="一括適用" Click="ApplyBulkMatrix_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom"/>
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="選択日の現在値"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="320">
            <Grid x:Name="MatrixGrid"/>
        </ScrollViewer>
    </StackPanel>
</Border>
<Border x:Name="GroupLessonClassCard" Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Visibility="Collapsed">
    <StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="3.1 集団授業クラスの登録"/>
        <TextBlock Text="集団授業のクラスと、それが開講される日程・コマを登録します。同じ学年でも複数のクラスを登録できます。" TextWrapping="Wrap"/>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="GroupClassName" Header="クラス名"/>
            <ComboBox x:Name="GroupClassGrade" Grid.Column="1" Header="対象学年" IsEditable="True"/>
            <CheckBox x:Name="GroupClassAllowOtherGrades" Grid.Column="2" Content="他学年の受講を許可" VerticalAlignment="Bottom"/>
            <Button x:Name="SaveGroupClassButton" Grid.Column="3" VerticalAlignment="Bottom" Content="保存" Click="SaveGroupClass_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="新規入力" Click="NewGroupClass_Click"/><Button Content="選択したクラスを削除" Click="DeleteGroupClass_Click"/></StackPanel>
        <ListView x:Name="GroupClasses" SelectionChanged="GroupClasses_SelectionChanged" MaxHeight="200"/>

        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="選択中のクラスの開講日程"/>
        <TextBlock x:Name="GroupClassSessionsHint" Text="上の一覧からクラスを選択してください。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="GroupSessionDate" Header="日付" DisplayMemberPath="Label"/>
            <ComboBox x:Name="GroupSessionSlot" Grid.Column="1" Header="コマ" DisplayMemberPath="Label"/>
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="この日程を追加" Click="AddGroupSession_Click"/>
        </Grid>
        <ListView x:Name="GroupSessions" MaxHeight="200"/>
        <Button Content="選択した日程を削除" Click="DeleteGroupSession_Click" HorizontalAlignment="Left"/>
    </StackPanel>
</Border>
<Border x:Name="GroupLessonEnrollmentCard" Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Visibility="Collapsed">
    <StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="3.2 集団授業の受講登録"/>
        <TextBlock Text="クラスを選び、そのクラスを受講する生徒にチェックを入れます。既定では対象学年の生徒だけを表示します（クラスの「他学年の受講を許可」がオンの場合は全学年を表示）。" TextWrapping="Wrap"/>
        <ComboBox x:Name="EnrollmentClass" Header="クラス" SelectionChanged="EnrollmentClass_SelectionChanged" MinWidth="280"/>
        <TextBlock x:Name="EnrollmentClassInfo" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBox x:Name="EnrollmentSearch" Header="生徒名検索" TextChanged="EnrollmentSearch_TextChanged"/>
        <ListView x:Name="EnrollmentStudents" MaxHeight="360">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Enrolled}" Checked="EnrollmentCheck_Changed" Unchecked="EnrollmentCheck_Changed" Content="{Binding Display}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Border>
</StackPanel></ScrollViewer></local:WorkflowPageBase>
