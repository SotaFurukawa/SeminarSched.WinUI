<local:WorkflowPageBase x:Class="SeminarSched_WinUI.Pages.ImportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SeminarSched_WinUI.Pages" NavigationCacheMode="Required" Loaded="Page_Loaded"><ScrollViewer><StackPanel MaxWidth="960" Padding="24" Spacing="16" HorizontalAlignment="Left"><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="③ アンケート取込"/><InfoBar x:Name="ProjectRequired"/><InfoBar x:Name="Status" IsClosable="True"/>
<Border Padding="24" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="🟦 Googleフォーム回答の取込"/>
        <TextBlock Text="Googleフォームからダウンロードしたアンケート回答を検証し、受講希望や出席出勤可能日をそのまま反映します。時間割配置後にアンケートを取り込み直す場合には、時間割のリセットを行ってください。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SurveySelectStudentButton" Content="① 生徒のアンケート回答ファイルを選ぶ" Click="SurveySelectStudent_Click" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="SurveySelectTeacherButton" Content="② 講師のアンケート回答ファイルを選ぶ" Click="SurveySelectTeacher_Click" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="SurveyVerifyButton" Content="③ 検証する" IsEnabled="False" Click="SurveyVerify_Click"/><Button x:Name="SurveyApplyButton" Content="④ 反映する" IsEnabled="False" Click="SurveyApply_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
        <TextBlock x:Name="SurveySelectedFilesText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="SurveySummary" TextWrapping="Wrap" Visibility="Collapsed"/>
        <ListView x:Name="SurveyIssues" MaxHeight="240"/>
    </StackPanel>
</Border>
<Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="受講希望"/>
        <TextBlock Text="必要な授業回数や希望の担当講師などを、生徒ごとに編集できます。マッチング優先度はホームの基本情報に対応しています。今回の講習限定で変更したい場合や、アンケート回答とは別で追加・修正したい場合は、一覧から選ぶと編集できます。" TextWrapping="Wrap"/>
        <!-- ユーザー指摘（checkpoint121）「この謎の隙間を埋めてほしい。詰めて書くこと」への対応。
             ComboBox/NumberBoxは既定でGridの"*"列いっぱいには広がらず、コントロール自身の
             実測サイズで表示されるため、"*"列だけ幅広に確保すると列とコントロールの間に
             不要な余白ができていた（HomePage.xamlの年度欄と同種の不具合）。列をAutoにし、
             代わりに各コントロール自身へ明示的なWidthを与えることで、列がコントロールの
             実際のサイズにぴったり沿うようにした。 -->
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="RequestStudent" Header="生徒" Width="180"/><ComboBox x:Name="RequestSubject" Grid.Column="1" Header="科目" Width="140"/><NumberBox x:Name="RequestRequiredSessions" Grid.Column="2" Header="必要授業回数" Minimum="1" Value="1" Width="140"/><ComboBox x:Name="RequestRegularTeacher" Grid.Column="3" Header="通常担当講師（任意）" SelectionChanged="RequestRegularTeacher_SelectionChanged" Width="200"/><NumberBox x:Name="RequestRegularPriority" Grid.Column="4" Header="優先度 1～5" Minimum="1" Maximum="5" Value="3" Width="100"/>
        </Grid>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="RequestPreferred1" Header="第1希望講師（任意）" Width="220"/><ComboBox x:Name="RequestPreferred2" Grid.Column="1" Header="第2希望講師（任意）" Width="220"/><ComboBox x:Name="RequestPreferred3" Grid.Column="2" Header="第3希望講師（任意）" Width="220"/>
        </Grid>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="RequestOneToOne" Header="1対1必須" SelectedIndex="0"><ComboBoxItem Content="いいえ"/><ComboBoxItem Content="はい"/></ComboBox><NumberBox x:Name="RequestMaxConsecutiveOverride" Grid.Column="1" Header="最大連続コマ数上書き（0=既定値）" Minimum="0" Value="0"/><ComboBox x:Name="RequestAllowGapOverride" Grid.Column="2" Header="空きコマ許可上書き" SelectedIndex="0"><ComboBoxItem Content="指定なし"/><ComboBoxItem Content="許可"/><ComboBoxItem Content="不許可"/></ComboBox>
        </Grid>
        <TextBox x:Name="RequestNote" Header="備考"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存" Click="SaveLessonRequest_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="新規入力" Click="NewLessonRequest_Click"/><Button Content="選択した行を削除" Click="DeleteLessonRequest_Click"/></StackPanel>
        <Grid ColumnSpacing="8" Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="70"/><ColumnDefinition Width="160"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold" Text="生徒氏名"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="科目名"/><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="必要回数"/><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="通常担当講師"/><TextBlock Grid.Column="4" FontWeight="SemiBold" Text="優先度"/><TextBlock Grid.Column="5" FontWeight="SemiBold" Text="1対1"/>
        </Grid>
        <ListView x:Name="LessonRequests" SelectionChanged="LessonRequests_SelectionChanged" MaxHeight="360">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="70"/><ColumnDefinition Width="160"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StudentName}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SubjectName}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value.RequiredSessions}"/>
                        <TextBlock Grid.Column="3" Text="{Binding RegularTeacherName}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Value.RegularTeacherPriority}"/>
                        <TextBlock Grid.Column="5" Text="{Binding OneToOneText}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Border>
<Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
    <StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="可用性の手動編集"/>
        <TextBlock Text="生徒または講師を1名選び、カレンダーで日ごとの参加可否をそのまま編集できます。チェックを入れると参加可能（緑）、外すと参加不可（赤）になり、保存操作なしですぐに反映されます。取込済みの回答も上書きされます。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton x:Name="MatrixStudentKind" Content="生徒" IsChecked="True" Checked="MatrixKind_Changed"/>
            <RadioButton x:Name="MatrixTeacherKind" Content="講師" Checked="MatrixKind_Changed"/>
        </StackPanel>
        <ComboBox x:Name="MatrixEntity" Header="対象" DisplayMemberPath="Label" SelectionChanged="MatrixEntity_SelectionChanged" MinWidth="280" HorizontalAlignment="Left"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel Spacing="4">
                <Grid x:Name="AvailabilityCalendarWeekdayHeader"/>
                <Grid x:Name="AvailabilityCalendarGrid" ColumnSpacing="4" RowSpacing="4"/>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</Border>
</StackPanel></ScrollViewer></local:WorkflowPageBase>
