<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SeminarSched_WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="880" Padding="24,16,24,32" HorizontalAlignment="Left" Spacing="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ホーム" />
            <InfoBar x:Name="StatusInfoBar" IsClosable="True" IsOpen="False" Severity="Informational" />

            <Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="生徒講師基本情報・通常授業担当情報" />
                    <TextBlock Text="生徒と講師の基本的な情報と、通常授業の担当をまとめたものです。プロジェクトごとの管理ではなく、一括した情報で、新規プロジェクト作成時に自動で反映されます。" TextWrapping="Wrap" />
                    <!-- ユーザー指示「『Excelで基本情報を編集』のあとに『編集した内容を反映』を押さないと
                         いけないということがわかるような導線にしてください」への対応。矢印で2つのボタンを
                         視覚的につなげ、この2つが一連の操作であることを示す。次の3つのボタンは別の操作
                         （新規作成・別ファイルからの反映・学年繰り上げ）のため、もう一段下へ分けた。 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="EditSharedRoster_Click" Content="Excelで基本情報を編集" Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock Text="→" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Click="ReflectSharedRosterEdits_Click" Content="編集した内容を反映" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="「Excelで基本情報を編集」で開いたファイルを上書き保存した後、「編集した内容を反映」を押すと、共通の基本情報および現在開いているプロジェクトへ反映されます（保存しただけでは自動的には反映されません）。" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="NewSharedRosterTemplate_Click" Content="新規で基本情報を作成" />
                        <Button Click="ImportSharedRoster_Click" Content="別ファイルの基本情報を反映" />
                        <Button Click="AdvanceGrades_Click" Content="学年を一括で繰り上げる" />
                    </StackPanel>
                    <TextBlock x:Name="SharedRosterPathText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SharedRosterLastModifiedText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="現在のプロジェクト" />
                    <TextBlock x:Name="CurrentProjectTitle" FontSize="18" Text="プロジェクトは開かれていません" />
                    <TextBlock x:Name="CurrentProjectPeriod" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CurrentProjectPath" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OpenProject_Click" Content="既存プロジェクトを開く" />
                        <Button Click="CloseProject_Click" Content="閉じる" />
                        <Button Click="CreateBackup_Click" Content="バックアップを作成" />
                        <Button Click="RestoreBackup_Click" Content="バックアップから復元" />
                        <Button Click="SaveAs_Click" Content="複製して切り替え" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="バックアップから復元する場合は、現在のプロジェクトが書き換えられますので、ご注意ください。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="最近使ったプロジェクト" />
                    <ListView x:Name="RecentProjectsList" IsItemClickEnabled="True" ItemClick="RecentProject_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Path}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Text="{Binding LastModifiedText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="プロジェクトを開く" Tag="{Binding Path}" Click="OpenRecentProjectButton_Click" />
                                        <Button Content="フォルダーを開く" Tag="{Binding Path}" Click="OpenRecentProjectFolder_Click" />
                                        <Button Content="表示しない" Tag="{Binding Path}" Click="HideRecentProject_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoRecentProjectsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="最近使ったプロジェクトはありません。" />
                </StackPanel>
            </Border>

            <Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="新しい講習プロジェクト" />
                    <!-- 不具合修正: 列幅を160/220/220の固定pxにしていたため、実際のコントロール幅より
                         列のほうがずっと広く、「年度」の年（DatePickerは非表示のDay/Month分の余白を
                         保持したまま全体幅が縮まらない）が列内で右寄りに表示されたり、「講習区分」と
                         「として保存」のプレビューの間に不要な余白ができたりしていた。各列をAutoにし、
                         代わりに各コントロール自身へ実測に合わせた明示的なWidthを与えることで、列が
                         コントロールの実際のサイズにぴったり沿うようにした。 -->
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DatePicker x:Name="AcademicYearPicker" Header="年度" DayVisible="False" MonthVisible="False" YearVisible="True" Width="200" />
                        <ComboBox x:Name="SeasonBox" Grid.Column="1" Header="講習区分" SelectedIndex="1" Width="140">
                            <ComboBoxItem Content="春期講習" Tag="1" />
                            <ComboBoxItem Content="夏期講習" Tag="2" />
                            <ComboBoxItem Content="冬期講習" Tag="3" />
                            <ComboBoxItem Content="その他" Tag="4" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <TextBox x:Name="GeneratedTitleBox" Width="160" IsReadOnly="True" />
                            <TextBlock Text="として保存" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="OtherSeasonNameBox" Grid.Row="1" Grid.Column="1" Header="講習区分の名称（その他を選択した場合）" Visibility="Collapsed" TextChanged="ProjectDefinition_Changed" Width="280" />
                        <CalendarDatePicker x:Name="StartDatePicker" Grid.Row="2" Header="開始日" DateChanged="ProjectDefinition_Changed" />
                        <CalendarDatePicker x:Name="EndDatePicker" Grid.Row="2" Grid.Column="1" Header="終了日" DateChanged="ProjectDefinition_Changed" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="整合性が確認できない場合には保存できない場合があります。また、同名のファイルが存在する場合は、末尾に番号をつけて保存します。"
                        TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="オプション機能" />
                    <CheckBox x:Name="ConsiderGroupLessonsCheck" Content="集団授業の日程を考慮する" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="オンにすると③アンケート取込に「集団授業クラスの登録」・「受講登録」の項目が追加されます。個別指導以外に集団授業も受講する生徒がいる場合に、選択してください。このオプションを選択すると、後から変更できません。"
                        TextWrapping="Wrap" />
                    <!-- 不具合修正: 「集団授業の日程を考慮する」とは無関係の設定のため連動を解除し、
                         専用のチェックボックスでのみ編集可否を切り替えるようにした（チェックを外すと
                         既定の2人へ戻す）。あわせて、Headerの文言が折り返さず1行で収まる幅へ広げた。 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="MaxStudentsPerTeacherEnableCheck" Content="既定値から変更する" VerticalAlignment="Bottom" Checked="MaxStudentsPerTeacherEnableCheck_Changed" Unchecked="MaxStudentsPerTeacherEnableCheck_Changed" />
                        <NumberBox
                            x:Name="MaxStudentsPerTeacherBox"
                            Header="一人の講師が同時に担当できる生徒数（既定は2人）"
                            Minimum="1"
                            Maximum="10"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="2"
                            IsEnabled="False"
                            HorizontalAlignment="Left"
                            Width="420" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="一人の講師が担当する生徒の人数を設定できます。後から「①設定」の「スケジュール設定」タブでも変更できます。"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Right"
                        Click="CreateProject_Click"
                        Content="保存先を選んで作成"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
