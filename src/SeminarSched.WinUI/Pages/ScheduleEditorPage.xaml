<?xml version="1.0" encoding="utf-8" ?>
<local:WorkflowPageBase
    x:Class="SeminarSched_WinUI.Pages.ScheduleEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SeminarSched_WinUI.Pages"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <InfoBar Grid.Row="0" x:Name="ProjectRequired" Margin="24,16,24,0" />
        <ScrollViewer Grid.Row="1" x:Name="ContentPanel">
        <StackPanel MaxWidth="1440" Padding="24,16,24,32" HorizontalAlignment="Left" Spacing="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="時間割編集" />
            <!-- ユーザー要望（checkpoint155）「『日別グリッド編集』から『...追加してください。』までの
                 文章をなくす」「枠外の『...右クリックから選択してください』に、セル右上のバツ印/丸印の
                 説明と『+講師を表示』の説明を追加する」への対応。カード冒頭にあった見出し「日別グリッド
                 編集」と、その下の講師出勤可否編集の説明をまとめて削除し、代わりにこのページ冒頭の説明文へ
                 その内容を追記した。 -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="時間割の自動作成前に、あらかじめ指定しておきたいコマをドラッグ・ドロップで指定できます。未配置一覧からセルへドラッグして配置してください。配置済みカードを未配置の状態にしたい場合は右クリックから選択してください。セル右上のバツ印/丸印から、講師の出勤可否をここでも変更できます。表示されていない講師を追加したい場合は、「+講師を表示」から追加してください。"
                TextWrapping="Wrap" />
            <InfoBar x:Name="EditorStatus" IsClosable="True" />

            <Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="12">
                    <!-- 不具合修正: 日付・検索・ボタン5個をすべて1行に並べていたため、ウィンドウを
                         縦長（狭幅）にすると*幅の生徒名検索がボタンに押し出されて潰れていた。日付・検索は
                         そのままの1行に収まる専用行とし、ボタン一式は別の行へ分けた。 -->
                    <!-- ユーザー要望（checkpoint151）「日付の横に、前や次の日付（授業日）を選択するように、
                         日付の左右に矢印を追加してほしい」への対応。BoardDateのItemsSourceは
                         GetOpenDatesAsync（SqliteScheduleEditorService）がDate昇順で返すため、
                         単純にSelectedIndexを±1するだけで前後の授業日へ切り替えられる。 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <!-- ユーザー要望（checkpoint152）「矢印を日付の枠の真横においてください。縦幅
                             などもそろえて、上枠と下枠が同じ高さになるように」への対応。矢印ボタンと
                             日付ComboBoxの間の隙間を無くし（Spacing="0"）、ボタンの高さをComboBoxの
                             入力枠部分（Header文字を除く）と同じ32pxに固定、VerticalAlignment="Bottom"
                             で下端をComboBoxの入力枠の下端に揃える。 -->
                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                            <Button x:Name="PreviousDateButton" Content="◀" Height="32" Padding="8,0" VerticalAlignment="Bottom" CornerRadius="4,0,0,4" Click="PreviousDate_Click" ToolTipService.ToolTip="前の授業日"/>
                            <ComboBox x:Name="BoardDate" Header="日付" DisplayMemberPath="Label" MinWidth="200" CornerRadius="0" SelectionChanged="BoardDate_SelectionChanged"/>
                            <Button x:Name="NextDateButton" Content="▶" Height="32" Padding="8,0" VerticalAlignment="Bottom" CornerRadius="0,4,4,0" Click="NextDate_Click" ToolTipService.ToolTip="次の授業日"/>
                        </StackPanel>
                        <TextBox x:Name="BoardSearch" Grid.Column="1" Header="生徒名検索" TextChanged="BoardSearch_TextChanged"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="UndoButton" VerticalAlignment="Bottom" Content="元に戻す" IsEnabled="False" Click="Undo_Click"/>
                        <Button x:Name="RedoButton" VerticalAlignment="Bottom" Content="やり直す" IsEnabled="False" Click="Redo_Click"/>
                        <Button x:Name="AddTeacherButton" VerticalAlignment="Bottom" Content="+ 講師を表示" Click="AddTeacher_Click"/>
                        <Button VerticalAlignment="Bottom" Content="すべてリセット" Click="ResetAll_Click"/>
                        <Button x:Name="GoToOptimizationButton" VerticalAlignment="Bottom" Content="5 時間割自動作成へ" Click="GoToOptimization_Click"/>
                    </StackPanel>
                    <!-- ユーザー指摘（checkpoint120）「自動作成の差分が見えなくなっています」への対応。
                         以前は220px「未配置」・*「時間割」・280px「差分＋変更履歴」の3列構成で、
                         時間割の右側に細い列として押し込まれ目立たなくなっていた。差分・変更履歴は
                         時間割の下へ移し、空いた分だけ時間割（*列）を右へ広げた。 -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="未配置"/>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Text="選択中の日付に配置できる受講希望だけを表示します。"/>
                            <ListView x:Name="UnplacedList" MaxHeight="480" CanDragItems="True" DragItemsStarting="UnplacedList_DragItemsStarting" DragItemsCompleted="UnplacedList_DragItemsCompleted">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4,6,4" Margin="0,2,0,0" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" MaxWidth="200">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Grade}" FontSize="11" Opacity="0.7"/>
                                                </StackPanel>
                                                <TextBlock FontSize="11" TextWrapping="Wrap">
                                                    <Run Text="{Binding SubjectShortName}"/><Run Text="　残り"/><Run Text="{Binding Remaining}"/><Run Text="回"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding AvailableSlotsText}" FontSize="10" Opacity="0.8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <ScrollViewer x:Name="BoardScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="480" ViewChanged="BoardScroll_ViewChanged">
                            <Grid x:Name="BoardGrid"/>
                        </ScrollViewer>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="DiffCard" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="自動作成の差分"/>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Text="直前に5 時間割自動作成を実行した時点からの変化です。"/>
                                <TextBlock x:Name="DiffSummary" FontSize="11" TextWrapping="Wrap"/>
                                <ListView x:Name="DiffDetailList" MaxHeight="260"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="変更履歴"/>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Text="手動配置・事前確定・ロック・出勤可否・元に戻す/やり直すの直近の操作を新しい順に表示します。"/>
                                <ListView x:Name="HistoryList" MaxHeight="260"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- ユーザー要望（checkpoint129）「複数コマ・複数講師の出勤可否を一括設定について、
                         可用性の手動編集と用途が被っているため、これは削除してもらって構わない」への
                         対応で、この一括設定UIを削除した（③アンケート取込の「可用性の手動編集」で
                         同等の操作ができる）。 -->
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</local:WorkflowPageBase>
