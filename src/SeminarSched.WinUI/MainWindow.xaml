<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SeminarSched_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SeminarSched_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ShikiWari"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="ShikiWari"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="ホーム"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- ユーザー要望（checkpoint122）「上側のタブだけでなく、左側のタブにもこれらを
                     選択できるようにしておきたい。設定を開いている間は右側に1.1, 1.2...のような
                     ボタンを設置する。設定が開かれていないときはこれを表示しない」への対応。
                     子項目はSetupPage.xamlのTabViewと同じ並び順（1.1〜1.8）にし、表示/選択状態の
                     同期はSetupPageNavStateとMainWindow.xaml.csのRefreshSetupNavState()で行う。 -->
                <NavigationViewItem x:Name="SetupNavItem" Content="1 設定" Tag="setup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEBD2;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="1.1 生徒" Tag="setupTab:0"/>
                        <NavigationViewItem Content="1.2 講師" Tag="setupTab:1"/>
                        <NavigationViewItem Content="1.3 講師指導可能科目" Tag="setupTab:2"/>
                        <NavigationViewItem Content="1.4 通常授業担当設定" Tag="setupTab:3"/>
                        <NavigationViewItem Content="1.5 コマ・開校日" Tag="setupTab:4"/>
                        <NavigationViewItem Content="1.6 スケジュール設定" Tag="setupTab:5"/>
                        <NavigationViewItem Content="1.7 科目" Tag="setupTab:6"/>
                        <NavigationViewItem Content="1.8 出力設定" Tag="setupTab:7"/>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="2 アンケート作成" Tag="questionnaire">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF0E3;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="3 アンケート取込" Tag="import">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE78C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="3.1 集団授業クラス" Tag="groupLessonClass" Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE902;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="3.2 集団授業の受講登録" Tag="groupLessonEnrollment" Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="4 時間割編集" Tag="scheduleEditor">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="5 時間割自動作成" Tag="optimization">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="6 出力" Tag="output">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE749;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="アプリ情報" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA3A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <!-- ユーザー要望「アプリウィンドウを縦長にしたときに、左タブはアイコンのみになったり
                     しますが、自動作成の文字はそのまま縦にならんでしまうので少し不格好です。そのため、
                     円形のゲージにして、円の真ん中に進行パーセンテージを表示、他の文字はなくすように
                     してください」への対応（checkpoint115）。ただし円形ゲージはペインがアイコンのみ
                     （Compact/Minimal）のときだけ使い、通常の展開時（ラベルが見えている状態）は
                     以前の仕様（タイトル・進捗バー・パーセンテージ＋残り時間のテキスト）に戻す
                     （checkpoint118、ユーザー指摘。円が56x56のままだと狭いCompactペイン幅から
                     はみ出すため、32x32へ縮小した）。表示切替はMainWindow.xaml.csの
                     RefreshOptimizationStatus()がNavView.DisplayModeを見て行う。 -->
                <Grid>
                    <StackPanel
                        x:Name="OptimizationStatusPanelExpanded"
                        Margin="12,4,12,12"
                        Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Spacing="4"
                        Tapped="OptimizationStatusPanel_Tapped"
                        Visibility="Collapsed">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="5 自動作成 実行中" TextWrapping="Wrap" />
                        <ProgressBar x:Name="OptimizationStatusBar" Maximum="100" Minimum="0" Value="0" />
                        <TextBlock x:Name="OptimizationStatusText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid
                        x:Name="OptimizationStatusPanelCompact"
                        Width="28"
                        Height="28"
                        Margin="6,4,6,6"
                        HorizontalAlignment="Center"
                        Tapped="OptimizationStatusPanel_Tapped"
                        Visibility="Collapsed">
                        <ProgressRing x:Name="OptimizationStatusRing" Width="28" Height="28" IsActive="False" IsIndeterminate="False" Maximum="100" Minimum="0" Value="0" />
                        <TextBlock x:Name="OptimizationStatusRingText" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </NavigationView.PaneFooter>
            <!-- ユーザー要望「保存などの成功通知を、ページ固定位置ではなくiPhoneの通知のように上部から
                 スライドインさせたい。通知のたびにページを一番上まで自動スクロールしてしまうのを
                 やめたい」への対応。各ページのInfoBar（内容がページの状態そのものではなく、単発の
                 操作結果を知らせるだけのもの）の代わりに、MainWindowが1つだけ持つこのオーバーレイへ
                 通知する。どのページのScrollViewerにも属さないため、通知を出してもページのスクロール
                 位置に影響しない。ToastNotificationState.ShowSuccess()経由でMainWindow.xaml.csの
                 ShowToast()が呼ばれ、TranslateTransformでスライドイン・スライドアウトを行う（InfoBar
                 自体の開閉アニメーションは使わず、常時Visibleのまま Y座標だけを動かすことで、2件目が
                 来たときの「先に出ているものをスライドアウトさせてから2件目をスライドインさせる」
                 という逐次アニメーションを自前で制御できるようにしている）。
                 ユーザー指摘「横幅を、タブバーにかからないぐらいから右端まで（ページの横の長さ分より
                 ほんの少し短いくらい）にしたい。ウィンドウが可変だった場合には、その長さに調整する
                 こと」への対応。NavigationViewの兄弟要素（ウィンドウ全体に重なる）ではなく、
                 NavigationView自体のContent（NavFrameと同じGridの中）に置くことで、左ペイン（タブ
                 バー）を除いたコンテンツ領域の幅にだけ連動する。ウィンドウ幅やペインの展開／収納に
                 応じてGridが自動で再レイアウトされるため、明示的なハンドリングなしで追従する。 -->
            <Grid>
                <Frame x:Name="NavFrame" />
                <Border
                    x:Name="ToastBorder"
                    Margin="12,16,12,0"
                    Padding="16,12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTransform" Y="-160" />
                    </Border.RenderTransform>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE930;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <!-- ユーザー指摘「文字列はアイコンの右側に左詰めで」への対応。 -->
                        <TextBlock x:Name="ToastText" Grid.Column="1" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button Grid.Column="2" x:Name="ToastCloseButton" Click="ToastClose_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
