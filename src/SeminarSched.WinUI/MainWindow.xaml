<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SeminarSched_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SeminarSched_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ShikiWari"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="ShikiWari"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="ホーム"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="① 設定" Tag="setup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEBD2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="② アンケート作成" Tag="questionnaire">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF0E3;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="③ アンケート取込" Tag="import">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE78C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="3.1 集団授業クラス" Tag="groupLessonClass" Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE902;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="3.2 集団授業の受講登録" Tag="groupLessonEnrollment" Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="④ 時間割編集" Tag="scheduleEditor">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="⑤ 時間割自動作成" Tag="optimization">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="⑥ 出力" Tag="output">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE749;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="アプリ情報" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA3A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <!-- ユーザー要望「アプリウィンドウを縦長にしたときに、左タブはアイコンのみになったり
                     しますが、自動作成の文字はそのまま縦にならんでしまうので少し不格好です。そのため、
                     円形のゲージにして、円の真ん中に進行パーセンテージを表示、他の文字はなくすように
                     してください」への対応（checkpoint115）。ただし円形ゲージはペインがアイコンのみ
                     （Compact/Minimal）のときだけ使い、通常の展開時（ラベルが見えている状態）は
                     以前の仕様（タイトル・進捗バー・パーセンテージ＋残り時間のテキスト）に戻す
                     （checkpoint118、ユーザー指摘。円が56x56のままだと狭いCompactペイン幅から
                     はみ出すため、32x32へ縮小した）。表示切替はMainWindow.xaml.csの
                     RefreshOptimizationStatus()がNavView.DisplayModeを見て行う。 -->
                <Grid>
                    <StackPanel
                        x:Name="OptimizationStatusPanelExpanded"
                        Margin="12,4,12,12"
                        Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Spacing="4"
                        Tapped="OptimizationStatusPanel_Tapped"
                        Visibility="Collapsed">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="⑤ 自動作成 実行中" TextWrapping="Wrap" />
                        <ProgressBar x:Name="OptimizationStatusBar" Maximum="100" Minimum="0" Value="0" />
                        <TextBlock x:Name="OptimizationStatusText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid
                        x:Name="OptimizationStatusPanelCompact"
                        Width="28"
                        Height="28"
                        Margin="6,4,6,6"
                        HorizontalAlignment="Center"
                        Tapped="OptimizationStatusPanel_Tapped"
                        Visibility="Collapsed">
                        <ProgressRing x:Name="OptimizationStatusRing" Width="28" Height="28" IsActive="False" IsIndeterminate="False" Maximum="100" Minimum="0" Value="0" />
                        <TextBlock x:Name="OptimizationStatusRingText" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </NavigationView.PaneFooter>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
