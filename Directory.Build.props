<Project>
  <PropertyGroup>
    <!-- ユーザーの明示指示（「今回完成品として一度提出するので、V1.0.0としてリリース」）により、
         AGENTS.mdの既定運用（開発版はv0.x.x、明示指示なしにv1.0.0へ上げない）を離れ、このversionを
         v1.0.0として確定する。VersionSuffixを空にし、「-beta」の付かない正式versionにした。 -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppxPackageVersion>1.0.0.0</AppxPackageVersion>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
